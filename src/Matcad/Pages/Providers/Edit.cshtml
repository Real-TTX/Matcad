@page
@model Matcad.Pages.Providers.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Create provider" : "Edit provider";
}
<div class="card">
    <div class="card__body">
        @if (Model.Error != null)
        {
            <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
        }
        @if (Model.TestResult is { } test)
        {
            var kind = test.Ok == true ? "success" : (test.Ok == false ? "error" : "warning");
            <div class="alert alert--@kind"><icon name="@(test.Ok == true ? "check-circle" : test.Ok == false ? "x-circle" : "info")" /><span>@test.Message</span></div>
        }
        <form method="post" class="mat-form">
            <input type="hidden" asp-for="Id" />
            <mat-field label="Name" asp-for="Name">
                <input asp-for="Name" class="mat-input" placeholder="e.g. Netcup production" autofocus />
            </mat-field>

            <partial name="Controls/_ProviderFields" model="@(new ProviderFieldsModel
            {
                TypeFieldName = nameof(Model.Type), Type = Model.Type, CustomModule = Model.CustomModule,
                Values = Model.CredentialValues, CustomCredentials = Model.CustomCredentials
            })" />

            <mat-form-buttons>
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <button type="submit" class="mat-btn" asp-page-handler="Test" formnovalidate><icon name="check-circle" /><span>Test credentials</span></button>
                <a class="mat-btn mat-btn--ghost" asp-page="Index"><icon name="back" /><span>Back</span></a>
                @if (!Model.IsNew)
                {
                    <span class="mat-buttons__spacer"></span>
                    <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete this provider?">
                        <icon name="trash" /><span>Delete</span>
                    </button>
                }
            </mat-form-buttons>
        </form>
    </div>
</div>
