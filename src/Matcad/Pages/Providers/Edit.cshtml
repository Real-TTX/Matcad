@page
@model Matcad.Pages.Providers.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New DNS provider" : "Edit DNS provider";
    ViewData["PageSub"] = "The credentials Caddy needs to answer the DNS challenge of a wildcard certificate.";
    ViewData["Crumbs"] = Crumbs.Of(("DNS providers", "/Providers"), (Model.IsNew ? "New DNS provider" : "Edit DNS provider", null));
    ViewData["Width"] = "narrow";
}

<form method="post" class="mat-form" novalidate>
    <input type="hidden" asp-for="Id" />

    @if (Model.Error != null)
    {
        <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@Model.Error</div></div>
    }
    @if (Model.TestResult is { } test)
    {
        var tone = test.Ok == true ? "success" : test.Ok == false ? "danger" : "info";
        <div class="mat-alert mat-alert--@tone" role="status">@Ui.Icon(test.Ok == true ? "check-circle" : test.Ok == false ? "x-circle" : "info")<div class="mat-alert__body">@test.Message</div></div>
    }

    <section class="mat-card" aria-labelledby="provider-title">
        <div class="mat-card__head">@Ui.Icon("cloud")<h2 class="mat-card__title" id="provider-title">Provider</h2></div>
        <div class="mat-card__body mat-stack">
            <mat-field label="Name" asp-for="Name" required>
                <input asp-for="Name" class="mat-input" autofocus required data-msg-required="Please give the provider a name." />
            </mat-field>

            <partial name="Controls/_ProviderFields" model="Model.Fields" />
        </div>
    </section>

    <mat-form-buttons>
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>Save</span></button>
        <button type="submit" class="mat-btn mat-btn--secondary" asp-page-handler="Test" formnovalidate>@Ui.Icon("check-circle")<span>Test credentials</span></button>
        <a class="mat-btn mat-btn--secondary" asp-page="Index">@Ui.Icon("back")<span>Back</span></a>
        @if (!Model.IsNew)
        {
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete the provider @Model.Name? This cannot be undone." data-confirm-ok="Delete">
                @Ui.Icon("trash")<span>Delete</span>
            </button>
        }
    </mat-form-buttons>
</form>
