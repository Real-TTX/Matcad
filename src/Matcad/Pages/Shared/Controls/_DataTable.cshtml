@model Matcad.Controls.DataTable
@{
    var hasEdit = Model.Rows.Any(r => r.EditUrl != null);
    var colCount = Model.Columns.Count + (hasEdit ? 1 : 0);
}

<div class="mat-table" id="@Model.Id">
    <div class="mat-table__toolbar">
        <form method="get" class="js-autosubmit">
            <div class="search">
                <icon name="search" />
                <input type="search" name="@Model.SearchParam" value="@Model.SearchValue" class="mat-input"
                       placeholder="@Model.SearchPlaceholder" aria-label="@Model.SearchPlaceholder" enterkeyhint="search" />
            </div>
            @foreach (var f in Model.Filters)
            {
                <div class="toolbar-field">
                    <label for="@(Model.Id)-@f.Param">@f.Label</label>
                    <select id="@(Model.Id)-@f.Param" name="@f.Param" class="mat-select">
                        @foreach (var (value, text) in f.Options)
                        {
                            <option value="@value" selected="@(f.Selected == value)">@text</option>
                        }
                    </select>
                </div>
            }
            @* Preserve sort while searching. *@
            @if (!string.IsNullOrEmpty(Model.Sort))
            {
                <input type="hidden" name="@Model.SortParam" value="@Model.Sort" />
                <input type="hidden" name="@Model.DirParam" value="@Model.Dir" />
            }
            @foreach (var kv in Model.ExtraQuery)
            {
                <input type="hidden" name="@kv.Key" value="@kv.Value" />
            }
        </form>
    </div>

    <div class="mat-table__scroll">
        <table class="data">
            <thead>
                <tr>
                    @foreach (var col in Model.Columns)
                    {
                        <th class="@(col.HideOnSmall ? "hide-sm" : "")">
                            @if (!string.IsNullOrEmpty(col.SortKey))
                            {
                                <a href="@Model.SortLink(col.SortKey)">@col.Header @Model.SortIndicator(col.SortKey)</a>
                            }
                            else
                            {
                                @col.Header
                            }
                        </th>
                    }
                    @if (hasEdit)
                    {
                        <th class="actions"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="@colCount" class="empty">@Model.EmptyText</td></tr>
                }
                else
                {
                    foreach (var row in Model.Rows)
                    {
                        <tr>
                            @for (var i = 0; i < row.Cells.Count; i++)
                            {
                                <td class="@(i < Model.Columns.Count && Model.Columns[i].HideOnSmall ? "hide-sm" : "")">@row.Cells[i]</td>
                            }
                            @if (hasEdit)
                            {
                                <td class="actions">
                                    @if (row.EditUrl != null)
                                    {
                                        <a class="mat-btn mat-btn--icon mat-btn--sm mat-btn--ghost" href="@row.EditUrl" title="Edit" aria-label="Edit"><icon name="edit" /></a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="mat-table__pagination">
            <nav class="mat-pagination" aria-label="Pages">
                <ul class="mat-pagination__pages">
                    <li class="mat-pagination__page @(Model.Page > 1 ? "" : "is-disabled")">
                        @if (Model.Page > 1) { <a href="@Model.Link((Model.PageParam, (Model.Page - 1).ToString()))" aria-label="Previous"><icon name="chevron-left" /></a> }
                        else { <span><icon name="chevron-left" /></span> }
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="mat-pagination__page @(p == Model.Page ? "is-current" : "")">
                            @if (p == Model.Page) { <span aria-current="page">@p</span> }
                            else { <a href="@Model.Link((Model.PageParam, p.ToString()))">@p</a> }
                        </li>
                    }
                    <li class="mat-pagination__page @(Model.Page < Model.TotalPages ? "" : "is-disabled")">
                        @if (Model.Page < Model.TotalPages) { <a href="@Model.Link((Model.PageParam, (Model.Page + 1).ToString()))" aria-label="Next"><icon name="chevron-right" /></a> }
                        else { <span><icon name="chevron-right" /></span> }
                    </li>
                </ul>
            </nav>
        </div>
    }

    @if (Model.NewUrl != null)
    {
        <div class="mat-table__actions">
            <a class="mat-btn mat-btn--primary" href="@Model.NewUrl"><icon name="plus" /><span>@Model.NewLabel</span></a>
        </div>
    }
</div>
