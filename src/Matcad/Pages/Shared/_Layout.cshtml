@using System.Reflection
@{
    string IsActive(string page) =>
        (ViewContext.RouteData.Values["page"]?.ToString() ?? "").StartsWith(page, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
    var version = Assembly.GetExecutingAssembly()
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "local";
    var title = ViewData["Title"] as string;
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en" data-app-version="@version">
<head>
    <partial name="_Head" />
    <title>@(string.IsNullOrEmpty(title) ? "Matcad" : $"{title} · Matcad")</title>
</head>
<body class="is-app">
    <div class="app">
        <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
        <aside class="sidebar">
            <a class="brand" asp-page="/Index" aria-label="Dashboard">
                <img class="brand__logo" src="~/img/logo.svg" alt="" width="36" height="36" />
                <span class="brand__text">
                    <span class="brand__name">Matcad</span>
                    <span class="brand__version">@version</span>
                </span>
            </a>

            <nav class="sidebar__nav" aria-label="Main navigation">
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "is-active" : "")" asp-page="/Index"><icon name="dashboard" /><span>Dashboard</span></a>
                <a class="nav-link @IsActive("/Routes")" asp-page="/Routes/Index"><icon name="route" /><span>Routes</span></a>
                <a class="nav-link @IsActive("/Authentications")" asp-page="/Authentications/Index"><icon name="lock" /><span>Authentications</span></a>
                @if (isAdmin)
                {
                    <a class="nav-link @IsActive("/Providers")" asp-page="/Providers/Index"><icon name="cloud" /><span>Providers</span></a>
                }
                <a class="nav-link @IsActive("/Statistics")" asp-page="/Statistics"><icon name="bar-chart" /><span>Statistics</span></a>
                @if (isAdmin)
                {
                    <div class="nav-sep"></div>
                    <a class="nav-link @IsActive("/Settings")" asp-page="/Settings/Index"><icon name="settings" /><span>Settings</span></a>
                }
            </nav>

            <div class="sidebar__footer">
                <a class="account" asp-page="/Account/Profile" title="Account">
                    <span class="account__avatar"><icon name="user" /></span>
                    <span class="account__meta">
                        <span class="account__name">@User.Identity?.Name</span>
                        <span class="account__role">@(isAdmin ? "Admin" : "User")</span>
                    </span>
                </a>

                <div class="theme-switch" role="group" aria-label="Theme">
                    <button type="button" class="theme-switch__btn" data-theme-set="system" title="System" aria-label="System theme"><icon name="monitor" /></button>
                    <button type="button" class="theme-switch__btn" data-theme-set="light" title="Light" aria-label="Light theme"><icon name="sun" /></button>
                    <button type="button" class="theme-switch__btn" data-theme-set="dark" title="Dark" aria-label="Dark theme"><icon name="moon" /></button>
                </div>

                <form method="post" asp-page="/Logout" class="logout-form">
                    <button type="submit" class="nav-link nav-link--logout"><icon name="logout" /><span>Sign out</span></button>
                </form>
            </div>
        </aside>

        <div class="content">
            <header class="topbar">
                <label for="nav-toggle" class="topbar__menu" aria-label="Menu"><icon name="menu" /></label>
                <span class="topbar__title">@title</span>
            </header>
            <partial name="_ConnectionBanner" />
            <main class="main">
                @if (TempData["Flash"] is string flash)
                {
                    <div class="alert alert--success"><icon name="check-circle" /><span>@flash</span></div>
                }
                @if (TempData["FlashError"] is string flashError)
                {
                    <div class="alert alert--error"><icon name="x-circle" /><span>@flashError</span></div>
                }
                @if (TempData["FlashWarn"] is string flashWarn)
                {
                    <div class="alert alert--warning"><icon name="alert" /><span>@flashWarn</span></div>
                }
                <div class="page-head page-head--auto">
                    <div class="page-head__title"><h1>@title</h1></div>
                    @await RenderSectionAsync("Actions", required: false)
                </div>
                @RenderBody()
            </main>
        </div>
        <label for="nav-toggle" class="nav-backdrop" aria-hidden="true"></label>
    </div>

    <script src="~/js/matcad.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
