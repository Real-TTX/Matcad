@* Filled and shown by matcad.js while the server cannot be reached. *@
<div class="conn-banner" id="conn-banner" role="status" aria-live="polite" hidden>
    <icon name="wifi-off" />
    <span class="conn-banner__text" id="conn-banner-text"></span>
    <button type="button" class="mat-btn mat-btn--sm" data-conn-retry><icon name="refresh" /><span>Retry</span></button>
</div>
