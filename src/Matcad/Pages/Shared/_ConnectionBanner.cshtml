@* Filled and shown by matcad.js while the server cannot be reached; it stays at the bottom of the screen and does not push the page around. *@
<div class="mc-conn" id="conn-banner" role="status" aria-live="polite" hidden>
    <div class="mat-alert mat-alert--warning" id="conn-alert">
        @Ui.Icon("alert")
        <div class="mat-alert__body" id="conn-banner-text"></div>
        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-conn-retry>@Ui.Icon("refresh")<span>Retry</span></button>
    </div>
</div>
