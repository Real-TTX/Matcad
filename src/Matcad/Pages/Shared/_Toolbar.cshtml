@model ToolbarModel
@*
    The toolbar of a list (rules LIST-02, LIST-03, DIALOG-02): Search, Filter and Sort are buttons, each opens a dialog. With Model.SearchField the search is a
    field in the toolbar instead, and Filter and Sort stand together at its right end. All fields belong to the one GET form below (the inputs point to it with
    form="..."), so every dialog sends the complete state. Use it as the first child of <div class="mat-list">.
*@
@{
    var id = Model.Id;
    var form = id + "-form";
    // With the search in a field the field shows what is searched: no chip for it.
    var hasChips = (!Model.SearchField && Model.SearchActive) || Model.ActiveFilters > 0;
    var count = Model.Matching == Model.Total ? $"{Model.Total} {Model.Noun}" : $"{Model.Matching} of {Model.Total} {Model.Noun}";

    void FilterAndSort()
    {
        if (Model.Filters.Count > 0)
        {
            <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn @(Model.ActiveFilters > 0 ? "is-active" : "")" data-dialog-open="@id-filter" aria-haspopup="dialog">
                @Ui.Icon("sliders")<span>Filter</span>@if (Model.ActiveFilters > 0) { <span class="mat-badge">@Model.ActiveFilters</span> }
            </button>
        }

        if (Model.SortOptions.Count > 0)
        {
            <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn @(Model.SortActive ? "is-active" : "")" data-dialog-open="@id-sort" aria-haspopup="dialog">
                @Ui.Icon("sort")<span>Sort</span>@if (Model.SortActive) { <small>@Model.SortLabel @(Model.Descending ? "↓" : "↑")</small> }
            </button>
        }
    }
}

<div class="mat-toolbar" role="toolbar" aria-label="@Model.Label tools">
    @if (Model.SearchField)
    {
        <div class="mat-input-icon mat-toolbar__search">
            @Ui.Icon("search")
            <input class="mat-input" type="search" id="@id-q" name="q" form="@form" value="@Model.Search" placeholder="@Model.SearchPlaceholder" aria-label="@Model.Label: search" autocomplete="off" enterkeyhint="search" data-shortcut="/" />
        </div>

        <span class="mat-toolbar__spacer"></span>
        <span class="mat-toolbar__info" aria-live="polite">@count</span>
        <div class="mat-toolbar__end">
            @{ FilterAndSort(); }
        </div>
    }
    else
    {
        <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn @(Model.SearchActive ? "is-active" : "")" data-dialog-open="@id-search" data-shortcut="/" aria-haspopup="dialog">
            @Ui.Icon("search")<span>Search</span>@if (Model.SearchActive) { <small>“@Model.Search”</small> }
        </button>
        FilterAndSort();

        <span class="mat-toolbar__spacer"></span>

        <span class="mat-toolbar__info" aria-live="polite">@count</span>
    }
</div>

@if (hasChips)
{
    <div class="mat-chips" role="group" aria-label="Applied tools">
        @if (!Model.SearchField && Model.SearchActive)
        {
            <span class="mat-chip">Search: @Model.Search<a class="mat-chip__x" href="@Model.UrlWithout("q")" aria-label="Remove the search">@Ui.Icon("x")</a></span>
        }
        @foreach (var f in Model.Filters.Where(f => !string.IsNullOrEmpty(f.Selected)))
        {
            <span class="mat-chip">@f.Label: @(f.Options.FirstOrDefault(o => o.Value == f.Selected)?.Label ?? f.Selected)<a class="mat-chip__x" href="@Model.UrlWithout(f.Name)" aria-label="Remove the filter @f.Label">@Ui.Icon("x")</a></span>
        }
    </div>
}

<form id="@form" method="get" action="@Model.Action" hidden></form>

@if (!Model.SearchField)
{
    <dialog class="mat-dialog mat-dialog--sm" id="@id-search" aria-labelledby="@id-search-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @Ui.Icon("search")
                <h2 class="mat-dialog__title" id="@id-search-title">Search</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@Ui.Icon("x")</button>
            </div>
            <div class="mat-dialog__body">
                <div class="mat-field">
                    <label class="mat-label" for="@id-q">Search for</label>
                    <input class="mat-input" type="search" id="@id-q" name="q" form="@form" value="@Model.Search" placeholder="@Model.SearchPlaceholder" autocomplete="off" />
                    <span class="mat-hint">Press <kbd>/</kbd> on the page to open this dialog.</span>
                </div>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" form="@form" class="mat-btn mat-btn--primary">@Ui.Icon("search")<span>Apply</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    <span class="mat-btn-row__spacer"></span>
                    <a class="mat-btn mat-btn--ghost mat-btn--end" href="@Model.UrlWithout("q")">Clear search</a>
                </div>
            </div>
        </div>
    </dialog>
}

@if (Model.Filters.Count > 0)
{
    <dialog class="mat-dialog mat-dialog--sm" id="@id-filter" aria-labelledby="@id-filter-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @Ui.Icon("sliders")
                <h2 class="mat-dialog__title" id="@id-filter-title">Filter</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@Ui.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                @foreach (var f in Model.Filters)
                {
                    <div class="mat-field">
                        <label class="mat-label" for="@id-f-@f.Name">@f.Label</label>
                        <select class="mat-select" id="@id-f-@f.Name" name="@f.Name" form="@form">
                            <option value="">@f.AllLabel</option>
                            @foreach (var o in f.Options)
                            {
                                <option value="@o.Value" selected="@(f.Selected == o.Value)">@o.Label</option>
                            }
                        </select>
                    </div>
                }
                @if (Model.SearchActive || Model.SortActive)
                {
                    <p class="mat-hint">The search and the sort in effect are kept.</p>
                }
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" form="@form" class="mat-btn mat-btn--primary">@Ui.Icon("sliders")<span>Apply</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    <span class="mat-btn-row__spacer"></span>
                    <a class="mat-btn mat-btn--ghost mat-btn--end" href="@Model.Action">Reset everything</a>
                </div>
            </div>
        </div>
    </dialog>
}

@if (Model.SortOptions.Count > 0)
{
    <dialog class="mat-dialog mat-dialog--sm" id="@id-sort" aria-labelledby="@id-sort-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @Ui.Icon("sort")
                <h2 class="mat-dialog__title" id="@id-sort-title">Sort</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@Ui.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-label">Sort by</legend>
                    <div class="mat-options">
                        @foreach (var o in Model.SortOptions)
                        {
                            <label class="mat-option"><input type="radio" id="@id-sort-by-@o.Value" name="sort" value="@o.Value" form="@form" checked="@((Model.Sort ?? Model.DefaultSort) == o.Value)" /><span>@o.Label</span></label>
                        }
                    </div>
                </fieldset>
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-label">Order</legend>
                    <div class="mat-options">
                        <label class="mat-option"><input type="radio" id="@id-dir-asc" name="dir" value="asc" form="@form" checked="@(!Model.Descending)" /><span>Ascending</span></label>
                        <label class="mat-option"><input type="radio" id="@id-dir-desc" name="dir" value="desc" form="@form" checked="@Model.Descending" /><span>Descending</span></label>
                    </div>
                </fieldset>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" form="@form" class="mat-btn mat-btn--primary">@Ui.Icon("sort")<span>Apply</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    <span class="mat-btn-row__spacer"></span>
                    <a class="mat-btn mat-btn--ghost mat-btn--end" href="@Model.UrlWithout("sort")">Default order</a>
                </div>
            </div>
        </div>
    </dialog>
}
