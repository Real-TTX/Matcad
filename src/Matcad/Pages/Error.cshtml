@page
@model Matcad.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
    Layout = "_PlainLayout";
}
<div class="login">
    <div class="card">
        <div class="card__body" style="text-align:center">
            <div style="font-size:2.4rem;color:var(--danger)"><icon name="alert" /></div>
            <h1>Something went wrong</h1>
            <p class="text-muted">The request could not be processed.</p>
            @if (Model.RequestId != null)
            {
                <p class="mono text-muted">Request id: @Model.RequestId</p>
            }
            <a asp-page="/Index" class="mat-btn mat-btn--primary"><icon name="home" /><span>Back to the dashboard</span></a>
        </div>
    </div>
</div>
