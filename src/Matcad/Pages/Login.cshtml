@page
@model Matcad.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_PlainLayout";
}
<div class="login">
    <div class="login__brand">
        <img src="~/img/logo.svg" alt="" />
        <span class="name">Matcad</span>
        <span class="tagline">Reverse proxy, simply managed</span>
    </div>

    <div class="card">
        <div class="card__body">
            @if (Model.Error != null)
            {
                <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
            }
            <form method="post" class="mat-form">
                <input type="hidden" asp-for="ReturnUrl" />
                <mat-field label="Username or e-mail address" asp-for="Username">
                    <input asp-for="Username" class="mat-input" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
                </mat-field>
                <mat-field label="Password" asp-for="Password">
                    <input asp-for="Password" type="password" class="mat-input" autocomplete="current-password" />
                </mat-field>
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--block"><icon name="login" /><span>Sign in</span></button>
            </form>
        </div>
    </div>
</div>
