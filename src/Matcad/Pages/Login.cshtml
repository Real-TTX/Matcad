@page
@model Matcad.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_LoginLayout";
}
<div class="login-card">
    <h1 class="login-brand"><partial name="_Logo" /> Matcad</h1>
    @if (Model.Error != null)
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    @if (Model.IdentityEnabled && Model.SsoError)
    {
        <div class="alert alert-error" id="login-sso-error">The sign-in through MatIdentity did not work, or MatIdentity cannot be reached. Sign in with your Matcad account.</div>
    }
    @if (Model.Denied)
    {
        <div class="alert alert-error" id="login-denied">MatIdentity signed you in, but Matcad cannot tell which account is yours (several accounts match, or the matching one is connected with another person). Ask an administrator.</div>
    }
    @if (Model.PendingLink != null)
    {
        <div class="alert alert-info" id="login-link">
            An account named <strong>@(Model.PendingLink.Email ?? Model.PendingLink.PreferredUserName)</strong> exists here.
            Sign in once with its password to connect it with MatIdentity, or cancel.
        </div>
    }
    else if (Model.LinkExpired)
    {
        <div class="alert alert-info" id="login-link-expired">The request to connect an account with MatIdentity has expired. Sign in through MatIdentity again to start over.</div>
    }
    @if (Model.ShowLocalForm)
    {
        <form method="post" id="login-form" asp-route-local="1">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" autocomplete="username" autofocus />
            </div>
            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">
                <icon name="logout" /> Sign in
            </button>
        </form>
        @if (Model.PendingLink != null)
        {
            <form method="post" asp-page-handler="CancelLink" class="login-alt">
                <button type="submit" class="btn btn-block">Cancel, do not connect</button>
            </form>
        }
    }
    @if (Model.IdentityEnabled)
    {
        <p class="login-alt">
            @if (Model.ShowLocalForm)
            {
                <a class="btn btn-block" id="login-identity" href="@Model.IdentitySignInUrl">Sign in with MatIdentity</a>
            }
            else
            {
                <a class="btn btn-primary btn-block" id="login-identity" href="@Model.IdentitySignInUrl">Sign in with MatIdentity</a>
                <a class="text-muted" href="@Model.LocalSignInUrl">Sign in with a Matcad account</a>
            }
        </p>
    }
</div>
