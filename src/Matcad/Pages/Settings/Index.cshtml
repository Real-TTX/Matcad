@page
@model Matcad.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
}
<div data-tab-group>
    <div class="mat-tabs" role="tablist">
        <button type="button" class="mat-tabs__tab is-active" data-tab="general"><icon name="settings" /><span>General</span></button>
        <button type="button" class="mat-tabs__tab" data-tab="users"><icon name="users" /><span>Users</span></button>
        <button type="button" class="mat-tabs__tab" data-tab="certs"><icon name="shield" /><span>Certificates</span></button>
        <button type="button" class="mat-tabs__tab" data-tab="docker"><icon name="whale" /><span>Docker</span></button>
        <button type="button" class="mat-tabs__tab" data-tab="caddy"><icon name="route" /><span>Caddy</span></button>
        <button type="button" class="mat-tabs__tab" data-tab="system"><icon name="save" /><span>Import / Export</span></button>
    </div>

    <div class="tab-panel is-active" data-panel="general">
        <div class="card"><div class="card__body">
            <form method="post" class="mat-form">
                <section class="settings-section mat-form">
                    <h2>Domains &amp; access</h2>
                    <div class="form-grid">
                        <mat-field label="Base domain" asp-for="BaseDomain"
                                   hint="Parent domain shared by protected routes. Enables one Matcad sign-in across all its subdomains (forward_auth cookie).">
                            <input asp-for="BaseDomain" class="mat-input" placeholder="example.com" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                        <mat-field label="Matcad host" asp-for="MatcadHost"
                                   hint="Exposes the Matcad UI through Caddy under this domain (read-only system route to matcad:4433).">
                            <input asp-for="MatcadHost" class="mat-input" placeholder="matcad.example.com" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                    </div>
                    <div>
                        <label class="mat-switch"><input type="checkbox" asp-for="SystemRouteEnabled" /><span>System route active</span></label>
                        <div class="mat-hint" style="margin-top:6px">Turn off to keep the UI reachable only on <code>:4433</code>.</div>
                    </div>
                </section>

                <section class="settings-section mat-form">
                    <h2>Login &amp; forward-auth</h2>
                    <div class="form-grid">
                        <mat-field label="Login behaviour" asp-for="PortalMode"
                                   hint="How visitors of a Matcad-protected route see the sign-in. Inline keeps them on the requested site, so nobody learns where Matcad runs.">
                            <select asp-for="PortalMode" class="mat-select">
                                <option value="inline">Inline - login shown on the protected site (hides Matcad)</option>
                                <option value="redirect">Redirect - send users to the Matcad login host</option>
                                <option value="unauthorized">Unauthorized - return a plain 401, no login form</option>
                            </select>
                        </mat-field>
                        <mat-field label="Login portal URL (redirect mode only)" asp-for="AuthPortalUrl" hint="If empty, the Matcad host is used.">
                            <input asp-for="AuthPortalUrl" class="mat-input" placeholder="empty = derived from Matcad host" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                    </div>
                </section>

                <section class="settings-section mat-form">
                    <h2>Caddy &amp; TLS</h2>
                    <div class="form-grid">
                        <mat-field label="Caddy admin URL" asp-for="CaddyAdminUrl">
                            <input asp-for="CaddyAdminUrl" class="mat-input" placeholder="http://caddy:2019" autocapitalize="none" spellcheck="false" />
                            <span class="mat-hint">Admin API: <span class="pill @(Model.CaddyStatus == "reachable" ? "pill--online" : "pill--offline")">@Model.CaddyStatus</span></span>
                        </mat-field>
                        <mat-field label="ACME e-mail (optional)" asp-for="AcmeEmail"
                                   hint="Let's Encrypt contact for expiry notices. Empty registers anonymously; certificates still work. Can be overridden per domain.">
                            <input asp-for="AcmeEmail" type="email" class="mat-input" placeholder="empty = anonymous" />
                        </mat-field>
                        <mat-field label="DNS propagation delay (s)" asp-for="AcmePropagationDelaySeconds"
                                   hint="Wait this long after writing the DNS-01 record before validating. 0 = default; for slow providers (netcup) try 120.">
                            <input asp-for="AcmePropagationDelaySeconds" type="number" min="0" inputmode="numeric" class="mat-input" />
                        </mat-field>
                        <mat-field label="DNS propagation timeout (s)" asp-for="AcmePropagationTimeoutSeconds"
                                   hint="Max wait for the record to appear on the nameservers. 0 = default; -1 skips the check (fixes netcup timeouts).">
                            <input asp-for="AcmePropagationTimeoutSeconds" type="number" min="-1" inputmode="numeric" class="mat-input" />
                        </mat-field>
                    </div>
                </section>

                <section class="settings-section mat-form">
                    <h2>Logs</h2>
                    <div class="form-grid">
                        <mat-field label="Retention (days)" asp-for="LogRetentionDays">
                            <input asp-for="LogRetentionDays" type="number" min="1" inputmode="numeric" class="mat-input" />
                        </mat-field>
                        <mat-field label="Retention (max rows)" asp-for="LogRetentionMaxRows" hint="Hard cap on stored request-log rows (0 = unlimited).">
                            <input asp-for="LogRetentionMaxRows" type="number" min="0" inputmode="numeric" class="mat-input" />
                        </mat-field>
                    </div>
                </section>

                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                    <button type="submit" class="mat-btn" asp-page-handler="Repush"><icon name="refresh" /><span>Re-push config</span></button>
                    <span class="mat-buttons__spacer"></span>
                    <button type="submit" class="mat-btn mat-btn--ghost" asp-page-handler="RerunSetup" formnovalidate><icon name="rocket" /><span>Re-run setup wizard</span></button>
                </mat-form-buttons>
            </form>
        </div></div>
    </div>

    <div class="tab-panel" data-panel="users">
        <div class="mat-table">
            <div class="mat-table__scroll">
                <table class="data">
                    <thead><tr><th>Username</th><th class="hide-sm">E-mail</th><th>Role</th><th class="hide-sm">Created</th><th class="actions"></th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td>@u.Username</td>
                                <td class="hide-sm text-muted">@(u.Email ?? "-")</td>
                                <td>
                                    @if (u.Role == Matcad.Data.UserRole.Admin)
                                    {
                                        <span class="mat-badge">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="mat-badge mat-badge--muted">User</span>
                                    }
                                </td>
                                <td class="hide-sm text-muted">@Cell.LocalTime(u.CreateDate, "date")</td>
                                <td class="actions"><a class="mat-btn mat-btn--icon mat-btn--sm mat-btn--ghost" asp-page="User" asp-route-id="@u.Id" title="Edit" aria-label="Edit @u.Username"><icon name="edit" /></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mat-table__actions">
                <a class="mat-btn mat-btn--primary" asp-page="User"><icon name="plus" /><span>New user</span></a>
            </div>
        </div>
    </div>

    <div class="tab-panel" data-panel="certs">
        <div class="card"><div class="card__body">
            <p class="text-muted">
                The certificates Caddy manages for your <strong>enabled</strong> routes. A wildcard route <code>*.domain</code> (with a DNS provider)
                yields <strong>one</strong> certificate that also covers its subdomains, so most routes need no certificate of their own.
            </p>
        </div></div>

        <div class="mat-table">
            <div class="mat-table__head"><icon name="shield" /><span>Wildcard certificates</span></div>
            @if (Model.Certificates.Wildcards.Count == 0)
            {
                <div class="empty-state">No wildcard certificates.</div>
            }
            else
            {
                <div class="mat-table__scroll">
                    <table class="route-table">
                        <thead><tr><th>Certificate (subjects)</th><th>DNS provider</th><th>Covers these routes</th></tr></thead>
                        <tbody class="group">
                            @foreach (var w in Model.Certificates.Wildcards)
                            {
                                <tr class="child">
                                    <td class="c-name"><span class="mat-badge mat-badge--success"><icon name="shield" /></span> @w.Subjects</td>
                                    <td>@w.Provider</td>
                                    <td class="c-meta">
                                        @if (w.CoveredHosts.Count == 0)
                                        {
                                            <span class="text-muted">no subdomain routes yet</span>
                                        }
                                        else
                                        {
                                            <ul class="cert-hosts">
                                                @foreach (var h in w.CoveredHosts)
                                                {
                                                    <li>@h</li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mat-table">
            <div class="mat-table__head"><icon name="alert" /><span>Individual certificates</span></div>
            @if (Model.Certificates.Individual.Count == 0)
            {
                <div class="empty-state">None: every route is covered by a wildcard (or internal).</div>
            }
            else
            {
                <div style="padding:12px 20px 0">
                    <div class="alert alert--warning">
                        <icon name="alert" />
                        <span>These hosts are <strong>not</strong> covered by a wildcard and would each request their <strong>own</strong> certificate. Add a matching <code>*.domain</code> wildcard route to avoid that.</span>
                    </div>
                </div>
                <div class="mat-table__scroll">
                    <table class="route-table">
                        <thead><tr><th>Host</th><th>Certificate</th></tr></thead>
                        <tbody class="group">
                            @foreach (var h in Model.Certificates.Individual)
                            {
                                <tr class="child">
                                    <td class="c-name">@h</td>
                                    <td><span class="mat-badge mat-badge--warning"><icon name="alert" /> Individual</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mat-table">
            <div class="mat-table__head"><icon name="lock" /><span>Internal (no public certificate)</span></div>
            @if (Model.Certificates.Internal.Count == 0)
            {
                <div class="empty-state">None: no localhost or IP hosts.</div>
            }
            else
            {
                <p class="text-muted" style="padding:4px 20px 0;margin:0">Served by Caddy's internal CA (localhost and IP hosts); no public certificate is issued.</p>
                <div class="mat-table__scroll">
                    <table class="route-table">
                        <thead><tr><th>Host</th><th>Certificate</th></tr></thead>
                        <tbody class="group">
                            @foreach (var h in Model.Certificates.Internal)
                            {
                                <tr class="child">
                                    <td class="c-name">@h</td>
                                    <td><span class="mat-badge mat-badge--muted">internal</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="tab-panel" data-panel="docker">
        <div class="card"><div class="card__body">
            <form method="post" asp-page-handler="Docker" class="mat-form">
                <section class="settings-section mat-form">
                    <h2>Discovery</h2>
                    <p class="text-muted">
                        Binds running containers as routes automatically (<code>&lt;container&gt;.&lt;base-domain&gt;</code> to the container).
                        Bound routes appear in the Routes list with a "Docker" badge and are read-only there.
                    </p>
                    <label class="mat-switch"><input type="checkbox" asp-for="DockerEnabled" /><span>Docker discovery active</span></label>
                    <div class="form-grid">
                        <mat-field label="Docker endpoint" asp-for="DockerEndpoint" hint="The socket must be mounted into the Matcad container (read-only).">
                            <input asp-for="DockerEndpoint" class="mat-input" placeholder="unix:///var/run/docker.sock" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                        <mat-field label="Base domain (auto-naming)" asp-for="DockerBaseDomain">
                            <input asp-for="DockerBaseDomain" class="mat-input" placeholder="empty = global base domain" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                    </div>
                    <label class="mat-switch"><input type="checkbox" asp-for="DockerRequireLabel" /><span>Only containers with matcad.enable=true (recommended)</span></label>
                </section>

                <section class="settings-section">
                    <h2>Container labels</h2>
                    <p class="text-muted" style="margin:0">
                        Fine-tune per container: <code>matcad.enable=true</code> · <code>matcad.host</code> · <code>matcad.port</code> · <code>matcad.auth</code> (authentication name;
                        a container that names an authentication that does not exist is not published).
                    </p>
                </section>

                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                </mat-form-buttons>
            </form>
        </div></div>

        <div class="mat-table">
            <div class="mat-table__head"><icon name="whale" /><span>Containers</span></div>
            @if (Model.DockerError != null)
            {
                <div style="padding:12px 20px 0"><div class="alert alert--error"><icon name="x-circle" /><span>Docker not reachable: @Model.DockerError</span></div></div>
            }
            else if (!Model.DockerEnabled)
            {
                <p class="text-muted" style="padding:4px 20px 12px;margin:0">Enable Docker discovery above to list the containers on this host.</p>
            }
            @if (Model.DockerContainers.Count == 0)
            {
                <div class="empty-state">No running containers detected.</div>
            }
            else
            {
                <p class="text-muted" style="padding:4px 20px 0;margin:0">All running containers: bound ones become routes, the rest show why they were skipped.</p>
                <div class="mat-table__scroll">
                    <table class="route-table">
                        <thead><tr><th>Container</th><th class="hide-sm">Image</th><th class="hide-sm">Ports</th><th>Host</th><th class="hide-sm">Auth</th><th>Status</th></tr></thead>
                        <tbody class="group">
                            @foreach (var c in Model.DockerContainers)
                            {
                                <tr class="child @(c.Bound ? "" : "route-off")">
                                    <td class="c-name">@c.Name</td>
                                    <td class="c-meta hide-sm">@c.Image</td>
                                    <td class="c-meta hide-sm">@c.Ports</td>
                                    <td class="rtarget">@(c.Host ?? "-")</td>
                                    <td class="hide-sm">@(string.IsNullOrEmpty(c.AuthName) ? "-" : c.AuthName)</td>
                                    <td>
                                        @if (c.Bound)
                                        {
                                            <span class="pill pill--online">Bound</span>
                                        }
                                        else
                                        {
                                            <span class="pill pill--unknown" title="@c.Status">Ignored</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="tab-panel" data-panel="caddy">
        <div class="card"><div class="card__body">
            <p class="text-muted">
                The Caddy configuration (JSON) that Matcad generates and pushes to Caddy through the admin API.
                <strong>Read-only</strong>: changes are made through Routes, Providers and Authentications. Matcad deliberately uses the JSON API, not a classic Caddyfile.
            </p>
            <div data-tab-group>
                <div class="mat-tabs">
                    <button type="button" class="mat-tabs__tab is-active" data-tab="live">Live (Caddy)</button>
                    <button type="button" class="mat-tabs__tab" data-tab="generated">Generated (Matcad)</button>
                </div>
                <div class="tab-panel is-active" data-panel="live">
                    <pre class="code-view"><code id="cfg-live">@Model.CaddyLiveJson</code></pre>
                    <mat-form-buttons><button type="button" class="mat-btn mat-btn--sm" data-copy-from="#cfg-live"><icon name="copy" /><span>Copy</span></button></mat-form-buttons>
                </div>
                <div class="tab-panel" data-panel="generated">
                    <pre class="code-view"><code id="cfg-generated">@Model.CaddyConfigJson</code></pre>
                    <mat-form-buttons><button type="button" class="mat-btn mat-btn--sm" data-copy-from="#cfg-generated"><icon name="copy" /><span>Copy</span></button></mat-form-buttons>
                </div>
            </div>
        </div></div>

        <div class="card"><div class="card__body">
            <h2>Raw / extra config (advanced)</h2>
            <p class="text-muted" style="margin-top:6px">
                Extra Caddy JSON that is <strong>deep-merged</strong> into the generated config (objects merge, arrays like <code>routes</code> are joined).
                Use it for anything Matcad does not model directly. The Caddyfile importer stores what it cannot map here. Invalid JSON is rejected on save.
            </p>
            <form method="post" asp-page-handler="Raw" class="mat-form">
                <textarea asp-for="RawCaddyJson" rows="10" class="mat-textarea" spellcheck="false"
                          placeholder='{ "apps": { "http": { "servers": { "matcad": { "routes": [ ... ] } } } } }'></textarea>
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save &amp; merge</span></button>
                </mat-form-buttons>
            </form>
        </div></div>
    </div>

    <div class="tab-panel" data-panel="system">
        <div class="card"><div class="card__body">
            <h2>Export</h2>
            <p class="text-muted" style="margin-top:6px">
                A full backup in Matcad's own format: settings, providers, routes, authentications and user accounts including password hashes.
                Sessions, logs and encryption keys are not included. <strong>Keep it safe</strong>, it contains secrets.
            </p>
            <mat-form-buttons>
                <a class="mat-btn mat-btn--primary" asp-page-handler="Export" download><icon name="download" /><span>Download backup (.json)</span></a>
            </mat-form-buttons>
        </div></div>

        <div class="card"><div class="card__body">
            <h2>Restore a backup</h2>
            <div class="alert alert--warning" style="margin-top:12px">
                <icon name="alert" />
                <span>Restoring <strong>replaces</strong> all current configuration and user accounts with the backup's contents.</span>
            </div>
            <form method="post" asp-page-handler="Restore" enctype="multipart/form-data" class="mat-form">
                <input asp-for="BackupFile" type="file" accept="application/json,.json" class="mat-input" aria-label="Backup file" />
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--danger" data-confirm="Replace ALL config and users with this backup?" data-confirm-ok="Restore">
                        <icon name="restore" /><span>Restore backup</span>
                    </button>
                </mat-form-buttons>
            </form>
        </div></div>

        <div class="card"><div class="card__body">
            <h2>Import a Caddyfile</h2>
            <p class="text-muted" style="margin-top:6px">Convert an existing Caddyfile into Matcad routes, with a preview before anything is applied.</p>
            <mat-form-buttons>
                <a class="mat-btn" asp-page="Import"><icon name="upload" /><span>Open Caddyfile import</span></a>
            </mat-form-buttons>
        </div></div>

        <div class="card"><div class="card__body">
            <h2>Example data</h2>
            <p class="text-muted" style="margin-top:6px">
                Load illustrative providers, routes and authentications (routes disabled) to explore Matcad. <strong>Overwrites</strong> the current settings with example values.
            </p>
            <form method="post" asp-page-handler="LoadExample">
                <mat-form-buttons>
                    <button type="submit" class="mat-btn" data-confirm="Load example data and overwrite current settings?" data-confirm-ok="Load"><icon name="sparkles" /><span>Load example data</span></button>
                </mat-form-buttons>
            </form>
        </div></div>
    </div>
</div>
