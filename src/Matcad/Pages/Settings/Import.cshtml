@page
@model Matcad.Pages.Settings.ImportModel
@{
    ViewData["Title"] = "Import Caddyfile";
}
<div class="card">
    <div class="card__header"><icon name="upload" /><span>Import a Caddyfile</span></div>
    <div class="card__body">
        <p class="text-muted">
            Paste an existing Caddyfile. Matcad adapts it with Caddy's own adapter and maps the recognizable parts (host, <code>reverse_proxy</code>,
            redirects, <code>basic_auth</code> and ACME DNS providers) to routes, authentications and providers. Anything it cannot model is kept as
            <strong>raw passthrough</strong>, so nothing is lost. Review the preview before applying.
        </p>

        @if (Model.Error != null)
        {
            <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
        }

        <form method="post" class="mat-form">
            <textarea asp-for="Caddyfile" rows="12" class="mat-textarea" spellcheck="false" aria-label="Caddyfile"
                      placeholder="example.com {&#10;    reverse_proxy backend:8080&#10;}"></textarea>
            <mat-form-buttons style="margin-top:0">
                <button type="submit" class="mat-btn mat-btn--primary" asp-page-handler="Preview"><icon name="search" /><span>Preview</span></button>
                <a class="mat-btn mat-btn--ghost" asp-page="/Settings/Index"><icon name="back" /><span>Back</span></a>
            </mat-form-buttons>
        </form>
    </div>
</div>

@if (Model.Preview is { } plan)
{
    <div class="card">
        <div class="card__header"><icon name="eye" /><span>Preview</span></div>
        <div class="card__body">
            @foreach (var note in plan.Notes)
            {
                <div class="alert alert--warning"><icon name="info" /><span>@note</span></div>
            }
            @if (Model.Warnings != null)
            {
                <p class="text-muted">Adapter warnings: <code>@Model.Warnings</code></p>
            }

            @if (plan.Routes.Count > 0)
            {
                <div class="mat-table">
                    <div class="mat-table__scroll">
                        <table class="route-table">
                            <thead><tr><th>Host</th><th>Target</th><th class="hide-sm">Auth</th><th class="hide-sm">Provider</th></tr></thead>
                            <tbody class="group">
                                @foreach (var ir in plan.Routes)
                                {
                                    <tr class="child">
                                        <td class="c-name">@ir.Route.Host @(ir.Route.Wildcard ? "(wildcard)" : "")</td>
                                        <td class="rtarget">@(ir.Route.Upstream ?? (ir.Route.FallbackUrl is not null ? "↪ " + ir.Route.FallbackUrl : "-"))</td>
                                        <td class="hide-sm">@(ir.BasicUsers.Count > 0 ? $"Basic ({ir.BasicUsers.Count})" : "-")</td>
                                        <td class="hide-sm">@(ir.ProviderName ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <form method="post" class="mat-form">
                <input type="hidden" asp-for="Caddyfile" />
                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary" asp-page-handler="Apply" data-confirm="Import these entries now?" data-confirm-ok="Import">
                        <icon name="save" /><span>Apply import</span>
                    </button>
                </mat-form-buttons>
            </form>
        </div>
    </div>
}
