@page
@using Matcad.Config
@model Matcad.Pages.Routes.IndexModel
@{
    ViewData["Title"] = "Routes";
}
<div class="mat-table">
    <div class="mat-table__toolbar">
        <form method="get" class="js-autosubmit">
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Search routes..." aria-label="Search routes" enterkeyhint="search" />
            </div>
            <div class="toolbar-field">
                <label for="route-status">Status</label>
                <select id="route-status" name="Status" class="mat-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">All</option>
                    <option value="enabled" selected="@(Model.Status == "enabled")">Active</option>
                    <option value="disabled" selected="@(Model.Status == "disabled")">Inactive</option>
                </select>
            </div>
        </form>
    </div>

    <div class="mat-table__scroll">
        <table class="route-table">
            <thead>
                <tr>
                    <th>Host</th>
                    <th class="hide-sm">Target</th>
                    <th class="hide-sm">Certificate</th>
                    <th class="hide-sm">Auth</th>
                    <th>Status</th>
                    <th class="c-actions"></th>
                </tr>
            </thead>
            @if (Model.Groups.Count == 0)
            {
                <tbody><tr><td colspan="6" class="empty-state">No routes found.</td></tr></tbody>
            }
            @foreach (var group in Model.Groups)
            {
                <tbody class="group">
                    <tr class="parent">
                        <td colspan="6">
                            <span class="grp-name"><icon name="network" /> @group.BaseDomain</span>
                            <span class="grp-count">· @group.Routes.Count</span>
                        </td>
                    </tr>
                    @foreach (var r in group.Routes)
                    {
                        var label = Model.SubLabel(r.Host);
                        var authName = Model.AuthName(r);
                        var cert = Model.Cert(r);
                        <tr class="child @(r.Enabled ? "" : "route-off")">
                            <td class="c-name">
                                <span class="branch">↳</span>
                                @if (label == "@")
                                {
                                    <span class="apex">(root)</span>
                                }
                                else
                                {
                                    <span class="sub">@label</span><span class="sub-domain">.@group.BaseDomain</span>
                                }
                                @if (r.Wildcard)
                                {
                                    <span class="mat-badge mat-badge--warning">Wildcard</span>
                                }
                                @if (r.Source == "system")
                                {
                                    <span class="mat-badge mat-badge--warning" title="Matcad self-exposure">System</span>
                                }
                                else if (r.Source == "docker")
                                {
                                    <span class="mat-badge" title="From Docker container @r.SourceDetail">Docker</span>
                                }
                            </td>
                            <td class="rtarget hide-sm">
                                @if (!string.IsNullOrEmpty(r.Upstream))
                                {
                                    @r.Upstream
                                }
                                else if (!string.IsNullOrEmpty(r.FallbackUrl))
                                {
                                    <text>↪ @r.FallbackUrl</text>
                                    <span class="mat-badge mat-badge--muted" title="Redirect">@(r.RedirectPermanent ? "301" : "302")</span>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </td>
                            <td class="hide-sm">
                                @switch (cert.Kind)
                                {
                                    case CertificatePlanner.CertKind.Wildcard:
                                        <span class="mat-badge mat-badge--success" title="Wildcard certificate"><icon name="shield" /> @cert.Subject</span>
                                        break;
                                    case CertificatePlanner.CertKind.Covered:
                                        <span class="mat-badge mat-badge--muted" title="Covered by a wildcard certificate"><icon name="shield" /> @cert.Subject</span>
                                        break;
                                    case CertificatePlanner.CertKind.Internal:
                                        <span class="mat-badge mat-badge--muted" title="Caddy internal CA (localhost/IP)">internal</span>
                                        break;
                                    default:
                                        <span class="mat-badge mat-badge--warning" title="Would request its own individual certificate"><icon name="alert" /> Individual</span>
                                        break;
                                }
                            </td>
                            <td class="hide-sm">
                                @if (authName != null)
                                {
                                    <span class="mat-badge">@authName</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (r.Enabled)
                                {
                                    <span class="pill pill--online">Active</span>
                                }
                                else
                                {
                                    <span class="pill pill--unknown">Inactive</span>
                                }
                            </td>
                            <td class="c-actions">
                                @if (!r.IsDerived)
                                {
                                    <a class="mat-btn mat-btn--icon mat-btn--sm mat-btn--ghost" asp-page="Edit" asp-route-id="@r.Id" title="Edit" aria-label="Edit @r.Host"><icon name="edit" /></a>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="child add-sub">
                        <td colspan="6">
                            <a class="mat-btn mat-btn--sm mat-btn--quiet" asp-page="Edit" asp-route-sub="@group.BaseDomain">
                                <icon name="plus" /><span>Add subdomain</span>
                            </a>
                        </td>
                    </tr>
                </tbody>
            }
        </table>
    </div>

    <div class="mat-table__actions">
        <a class="mat-btn mat-btn--primary" asp-page="Edit"><icon name="plus" /><span>New route</span></a>
    </div>
</div>

@if (Model.PortRoutes.Count > 0)
{
    <div class="mat-table">
        <div class="mat-table__head"><icon name="plug" /><span>Port bindings</span></div>
        <p class="text-muted" style="margin:0;padding:4px 20px 12px">
            Reachable directly as <code>http://&lt;host&gt;:&lt;port&gt;</code> (no domain, no DNS). Created through the API, for example to embed apps over a bare hostname or IP.
        </p>
        <div class="mat-table__scroll">
            <table class="route-table">
                <thead>
                    <tr><th>Port</th><th>Target</th><th class="hide-sm">Embedding</th><th>Status</th><th class="c-actions"></th></tr>
                </thead>
                <tbody class="group">
                    @foreach (var r in Model.PortRoutes)
                    {
                        <tr class="child @(r.Enabled ? "" : "route-off")">
                            <td class="c-name"><span class="sub">:@r.ListenPort</span></td>
                            <td class="rtarget">@(string.IsNullOrEmpty(r.Upstream) ? "-" : r.Upstream)</td>
                            <td class="hide-sm">
                                @if (r.AllowEmbedding)
                                {
                                    <span class="mat-badge" title="X-Frame-Options and CSP frame-ancestors are removed">Allowed</span>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </td>
                            <td>
                                @if (r.Enabled) { <span class="pill pill--online">Active</span> } else { <span class="pill pill--unknown">Inactive</span> }
                            </td>
                            <td class="c-actions">
                                @if (!r.IsDerived)
                                {
                                    <a class="mat-btn mat-btn--icon mat-btn--sm mat-btn--ghost" asp-page="Edit" asp-route-id="@r.Id" title="Edit" aria-label="Edit port @r.ListenPort"><icon name="edit" /></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
