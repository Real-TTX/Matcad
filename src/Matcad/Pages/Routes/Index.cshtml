@page
@using Matcad.Config
@model Matcad.Pages.Routes.IndexModel
@{
    ViewData["Title"] = "Routes";
    ViewData["PageSub"] = "The hosts Caddy serves, grouped by domain, and where each one goes.";
    ViewData["Crumbs"] = Crumbs.Of(("Routes", null));
    var tools = Model.Toolbar.SearchActive || Model.Toolbar.ActiveFilters > 0;
}

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Groups.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon">@Ui.Icon(tools ? "search" : "route")</span>
            @if (tools)
            {
                <div class="mat-empty__title">Nothing matches</div>
                <p>Change the search or the filter, or reset them.</p>
                <a class="mat-btn mat-btn--primary" asp-page="Index">@Ui.Icon("refresh")<span>Reset the tools</span></a>
            }
            else
            {
                <div class="mat-empty__title">No routes yet</div>
                <p>A route sends the requests for a host name to the service behind it.</p>
                <a class="mat-btn mat-btn--primary" asp-page="Edit">@Ui.Icon("plus")<span>Add your first route</span></a>
            }
        </div>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table" id="routes-table" data-groups="routes">
                <caption class="mat-sr-only">Routes by domain</caption>
                <thead>
                    <tr>
                        <th scope="col"><span class="mat-row mat-row--nowrap">Host <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-groups-set="toggle" data-groups-target="#routes-table" aria-label="Open or close all domains" data-tip="Open or close all">@Ui.Icon("chevron-down")</button></span></th>
                        <th scope="col" class="mat-hide-sm">Target</th>
                        <th scope="col" class="mat-hide-sm">Certificate</th>
                        <th scope="col" class="mat-hide-sm">Authentication</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                @foreach (var group in Model.Groups)
                {
                    <tbody class="mat-group" data-group="@group.BaseDomain" @(tools ? Html.Raw("data-group-fixed") : null)>
                        <tr class="mat-group__head">
                            <td class="mat-group__cell" colspan="6">
                                <div class="mat-group__bar">
                                    <button type="button" class="mat-group__toggle" data-group-toggle aria-expanded="true">@Ui.Icon("chevron-down", "mat-group__chev")<span class="mat-group__title">@group.BaseDomain</span><span class="mat-badge mat-badge--soft">@group.Routes.Count<span class="mat-sr-only"> routes</span></span></button>
                                </div>
                            </td>
                        </tr>
                        @foreach (var r in group.Routes)
                        {
                            var authName = Model.AuthName(r);
                            var cert = Model.Cert(r);
                            <tr class="mat-group__item @(r.Enabled ? "" : "mc-off")">
                                <td data-label="Host"><partial name="_RouteName" model="new RouteNameModel(r, Model.SubLabel(r.Host), group.BaseDomain)" /></td>
                                <td data-label="Target" class="mat-hide-sm mat-mono mat-text-break">
                                    @if (!string.IsNullOrEmpty(r.Upstream))
                                    {
                                        @r.Upstream
                                    }
                                    else if (!string.IsNullOrEmpty(r.FallbackUrl))
                                    {
                                        <text>↪ @r.FallbackUrl</text> <span class="mat-tag" title="Redirect">@(r.RedirectPermanent ? "301" : "302")</span>
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                                <td data-label="Certificate" class="mat-hide-sm">
                                    @switch (cert.Kind)
                                    {
                                        case CertificatePlanner.CertKind.Wildcard:
                                            <span class="mat-pill mat-pill--ok" title="Wildcard certificate">@Ui.Icon("shield")@cert.Subject</span>
                                            break;
                                        case CertificatePlanner.CertKind.Covered:
                                            <span class="mat-pill mat-pill--plain" title="Covered by a wildcard certificate">@Ui.Icon("shield")@cert.Subject</span>
                                            break;
                                        case CertificatePlanner.CertKind.Internal:
                                            <span class="mat-pill mat-pill--plain" title="Caddy internal CA (localhost/IP)">internal</span>
                                            break;
                                        default:
                                            <span class="mat-pill mat-pill--warn" title="Would request its own individual certificate">@Ui.Icon("alert")Individual</span>
                                            break;
                                    }
                                </td>
                                <td data-label="Authentication" class="mat-hide-sm">
                                    @if (authName != null) { <span class="mat-tag">@authName</span> }
                                    else { <span class="mat-muted">-</span> }
                                </td>
                                <td data-label="Status">
                                    @if (r.Enabled) { <span class="mat-pill mat-pill--ok">Active</span> }
                                    else { <span class="mat-pill">Inactive</span> }
                                </td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        @if (!r.Wildcard && !string.IsNullOrWhiteSpace(r.Host))
                                        {
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm mat-hide-sm" href="https://@r.Host" target="_blank" rel="noopener" aria-label="Open @r.Host" data-tip="Open">@Ui.Icon("external")</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr class="mat-group__add">
                            <td class="mat-group__cell" colspan="6"><a class="mat-btn mat-btn--ghost mat-btn--sm" asp-page="Edit" asp-route-sub="@group.BaseDomain">@Ui.Icon("plus")<span>Add a subdomain</span></a></td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
    }

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" asp-page="Edit">@Ui.Icon("plus")<span>New route</span></a>
    </div>
</div>

@if (Model.PortRoutes.Count > 0)
{
    <section class="mat-card" aria-labelledby="ports-title">
        <div class="mat-card__head">@Ui.Icon("plug")<h2 class="mat-card__title" id="ports-title">Port bindings</h2></div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">
                Reachable directly as <code>http://&lt;host&gt;:&lt;port&gt;</code> (no domain, no DNS). Created through the API, for example to embed apps over a bare host name or IP address.
            </p>
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Port bindings</caption>
                    <thead>
                        <tr><th scope="col">Port</th><th scope="col">Target</th><th scope="col" class="mat-hide-sm">Embedding</th><th scope="col">Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.PortRoutes)
                        {
                            <tr class="@(r.Enabled ? "" : "mc-off")">
                                <td data-label="Port">
                                    <div class="mat-table__name">
                                        @if (r.IsDerived) { <span class="mat-mono">:@r.ListenPort</span> }
                                        else { <a class="mat-mono" asp-page="Edit" asp-route-id="@r.Id">:@r.ListenPort</a> }
                                        @if (r.HasGuards) { <span class="mat-pill mat-pill--info" title="Requests that do not pass the guard are refused">@Ui.Icon("shield")Guarded</span> }
                                    </div>
                                </td>
                                <td data-label="Target" class="mat-mono mat-text-break">@(string.IsNullOrEmpty(r.Upstream) ? "-" : r.Upstream)</td>
                                <td data-label="Embedding" class="mat-hide-sm">
                                    @if (r.AllowEmbedding) { <span class="mat-tag" title="X-Frame-Options and CSP frame-ancestors are removed">Allowed</span> }
                                    else { <span class="mat-muted">-</span> }
                                </td>
                                <td data-label="Status">
                                    @if (r.Enabled) { <span class="mat-pill mat-pill--ok">Active</span> }
                                    else { <span class="mat-pill">Inactive</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
