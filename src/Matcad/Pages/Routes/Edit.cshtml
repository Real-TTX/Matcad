@page
@model Matcad.Pages.Routes.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New route" : "Edit route";
    ViewData["PageSub"] = Model.PortBinding is null
        ? "A host name, where its requests go, and who may see it."
        : "A port binding forwards a port of the proxy to a service.";
    ViewData["Crumbs"] = Crumbs.Of(("Routes", "/Routes"), (Model.IsNew ? "New route" : "Edit route", null));
    ViewData["Width"] = "narrow";
}

@if (Model.PortBinding is { } port)
{
    <form method="post" class="mat-form" novalidate>
        <input type="hidden" asp-for="Id" />
        @if (Model.Error != null)
        {
            <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@Model.Error</div></div>
        }
        <div class="mat-alert mat-alert--info">
            @Ui.Icon("info")
            <div class="mat-alert__body">This is a port binding (<code>:@port</code>). It is managed through the API: the proxy listens on that port and forwards to <code>@Model.Upstream</code>. Here it can only be deleted.</div>
        </div>
        <mat-form-buttons>
            <a class="mat-btn mat-btn--secondary" asp-page="Index">@Ui.Icon("back")<span>Back</span></a>
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete the port binding :@port?" data-confirm-ok="Delete">
                @Ui.Icon("trash")<span>Delete</span>
            </button>
        </mat-form-buttons>
    </form>
}
else
{
    <form method="post" class="mat-form" novalidate data-wildcard-parents="@Model.WildcardParentsJson" id="route-form">
        <input type="hidden" asp-for="Id" />

        @if (Model.Error != null)
        {
            <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@Model.Error</div></div>
        }

        <section class="mat-card" aria-labelledby="route-host-title">
            <div class="mat-card__head">@Ui.Icon("route")<h2 class="mat-card__title" id="route-host-title">Host</h2></div>
            <div class="mat-card__body mat-stack">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-legend">Type</legend>
                    <div class="mat-choices">
                        <label class="mat-choice">
                            <input type="radio" asp-for="RouteType" value="single" id="route-type-single" />
                            <span class="mat-choice__text"><strong>Single domain</strong><small>One concrete host, for example app.example.com</small></span>
                        </label>
                        <label class="mat-choice">
                            <input type="radio" asp-for="RouteType" value="wildcard" id="route-type-wildcard" />
                            <span class="mat-choice__text"><strong>Wildcard</strong><small>One certificate for every subdomain of a domain</small></span>
                        </label>
                    </div>
                </fieldset>

                <div class="mat-form__grid">
                    <mat-field label="Host" asp-for="Host" required>
                        <input asp-for="Host" id="host-input" class="mat-input" autocapitalize="none" autocomplete="off" spellcheck="false" autofocus required data-msg-required="Please enter a host." />
                        <span class="mat-hint" id="host-hint"></span>
                    </mat-field>
                    <mat-field label="Name" asp-for="Name" hint="Optional. The host is used when it is empty.">
                        <input asp-for="Name" class="mat-input" />
                    </mat-field>
                </div>

                <div class="mat-alert mat-alert--warning" id="wildcard-nudge" hidden>
                    @Ui.Icon("alert")
                    <div class="mat-alert__body">
                        <span id="wildcard-nudge-text"></span>
                        <div class="mat-alert__actions">
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="wildcard-nudge-btn">@Ui.Icon("network")<span>Use a wildcard instead</span></button>
                        </div>
                    </div>
                </div>

                <label class="mat-switch"><input type="checkbox" asp-for="Enabled" /><span class="mat-switch__track"></span><span>Route active</span></label>
            </div>
        </section>

        <section class="mat-card" aria-labelledby="route-target-title">
            <div class="mat-card__head">@Ui.Icon("external")<h2 class="mat-card__title" id="route-target-title">Target</h2></div>
            <div class="mat-card__body mat-stack">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-legend">What happens to a request</legend>
                    <div class="mat-choices">
                        <label class="mat-choice">
                            <input type="radio" asp-for="Target" value="proxy" id="target-proxy" />
                            <span class="mat-choice__text"><strong>Reverse proxy</strong><small>Forward it to a service</small></span>
                        </label>
                        <label class="mat-choice">
                            <input type="radio" asp-for="Target" value="redirect" id="target-redirect" />
                            <span class="mat-choice__text"><strong>Redirect</strong><small>Send the visitor to another address</small></span>
                        </label>
                    </div>
                </fieldset>

                <div class="mat-stack" data-show-if="#target-proxy" data-show-value="proxy">
                    <mat-field label="Upstream" asp-for="Upstream" hint="Requests are forwarded to this service, for example http://backend:8080 or whoami:80." required>
                        <input asp-for="Upstream" class="mat-input mat-mono" autocapitalize="none" autocomplete="off" spellcheck="false" required data-msg-required="Please enter the service to forward to." />
                    </mat-field>
                    <div class="mat-field">
                        <label class="mat-switch"><input type="checkbox" asp-for="InsecureSkipVerify" /><span class="mat-switch__track"></span><span>Skip TLS verification (insecure)</span></label>
                        <span class="mat-hint">For <code>https://</code> upstreams with a self-signed or invalid certificate. Ignored for plain <code>http://</code> services.</span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-switch"><input type="checkbox" asp-for="AllowEmbedding" /><span class="mat-switch__track"></span><span>Allow embedding in a frame</span></label>
                        <span class="mat-hint">Removes <code>X-Frame-Options</code> and the CSP <code>frame-ancestors</code> from the responses, so this site can be shown inside another page (for example Mattiverse or MatOS). Off by default: only turn it on for apps you want to embed.</span>
                    </div>
                </div>

                <div class="mat-stack" data-show-if="#target-redirect" data-show-value="redirect">
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" for="redirect-preset">Redirect to</label>
                            <select id="redirect-preset" class="mat-select">
                                <option value="">Pick an existing domain</option>
                                @foreach (var t in Model.RedirectTargets)
                                {
                                    <option value="@t">@t</option>
                                }
                                <option value="__other__">Another address</option>
                            </select>
                            <span class="mat-hint">Every request to this host is redirected there.</span>
                        </div>
                        <div class="mat-field">
                            <label class="mat-switch"><input type="checkbox" asp-for="PermanentRedirect" /><span class="mat-switch__track"></span><span>Permanent (301)</span></label>
                            <span class="mat-hint">Leave it off for a temporary redirect (302).</span>
                        </div>
                    </div>
                    <div id="redirect-url-group" hidden>
                        <mat-field label="Target address" asp-for="FallbackUrl">
                            <input asp-for="FallbackUrl" type="url" class="mat-input" placeholder="https://target.example.com" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                    </div>
                </div>
            </div>
        </section>

        <section class="mat-card" aria-labelledby="route-access-title">
            <div class="mat-card__head">@Ui.Icon("lock")<h2 class="mat-card__title" id="route-access-title">Access and certificate</h2></div>
            <div class="mat-card__body mat-stack">
                <div class="mat-form__grid">
                    <mat-field label="Authentication" asp-for="AuthenticationId">
                        <select asp-for="AuthenticationId" class="mat-select">
                            @foreach (var (value, text) in Model.AuthOptions)
                            {
                                <option value="@value" selected="@((Model.AuthenticationId?.ToString() ?? "") == value)">@text</option>
                            }
                        </select>
                    </mat-field>
                    <div data-show-if="#route-type-wildcard" data-show-value="wildcard">
                        <mat-field label="DNS provider" asp-for="ProviderId" hint="Needed for the wildcard certificate. It also covers the subdomains, so their routes need no provider of their own.">
                            <select asp-for="ProviderId" class="mat-select">
                                @foreach (var (value, text) in Model.ProviderOptions)
                                {
                                    <option value="@value" selected="@((Model.ProviderId?.ToString() ?? "") == value)">@text</option>
                                }
                            </select>
                        </mat-field>
                    </div>
                </div>

                <div data-show-if="#route-type-wildcard" data-show-value="wildcard">
                    <mat-field label="ACME e-mail address" asp-for="AcmeEmail" hint="Optional. The contact for the certificate of this domain; it replaces the global address under Settings.">
                        <input asp-for="AcmeEmail" type="email" class="mat-input" autocapitalize="none" autocomplete="off" />
                    </mat-field>
                </div>
            </div>
        </section>

        <mat-form-buttons>
            <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>Save</span></button>
            <a class="mat-btn mat-btn--secondary" asp-page="Index">@Ui.Icon("back")<span>Back</span></a>
            @if (!Model.IsNew)
            {
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete the route @Model.Host? This cannot be undone." data-confirm-ok="Delete">
                    @Ui.Icon("trash")<span>Delete</span>
                </button>
            }
        </mat-form-buttons>
    </form>
}

@section Scripts {
    <script src="~/js/route-edit.js" asp-append-version="true"></script>
}
