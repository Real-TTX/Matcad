@page
@model Matcad.Pages.Routes.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New route" : "Edit route";
    ViewData["PageSub"] = Model.PortBinding is null
        ? "A host name, where its requests go, and who may see it."
        : "A port of the proxy forwarded to a service.";
    ViewData["Crumbs"] = Crumbs.Of(("Routes", "/Routes"), (Model.IsNew ? "New route" : "Edit route", null));
    ViewData["Width"] = "narrow";
}

@if (Model.PortBinding is { } port)
{
    <form method="post" class="mat-form" novalidate>
        <input type="hidden" asp-for="Id" />
        @if (Model.Error != null)
        {
            <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@Model.Error</div></div>
        }
        <div class="mat-alert mat-alert--info">
            @Ui.Icon("info")
            <div class="mat-alert__body">Port <code>:@port</code> forwards to <code>@Model.Upstream</code>. Port bindings are managed through the API; here they can only be deleted.</div>
        </div>
        <mat-form-buttons>
            <a class="mat-btn mat-btn--secondary" asp-page="Index">@Ui.Icon("back")<span>Back</span></a>
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete the port binding :@port?" data-confirm-ok="Delete">
                @Ui.Icon("trash")<span>Delete</span>
            </button>
        </mat-form-buttons>
    </form>
}
else
{
    <form method="post" class="mat-form" novalidate data-wildcard-parents="@Model.WildcardParentsJson" id="route-form">
        <input type="hidden" asp-for="Id" />

        @if (Model.Error != null)
        {
            <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@Model.Error</div></div>
        }

        <section class="mat-card" aria-labelledby="route-host-title">
            <div class="mat-card__head">@Ui.Icon("route")<h2 class="mat-card__title" id="route-host-title">Host</h2></div>
            <div class="mat-card__body mat-stack">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-legend">Type</legend>
                    <div class="mat-choices">
                        <label class="mat-choice">
                            <input type="radio" asp-for="RouteType" value="single" id="route-type-single" />
                            <span class="mat-choice__text"><strong>Single domain</strong><small>One concrete host, for example app.example.com</small></span>
                        </label>
                        <label class="mat-choice">
                            <input type="radio" asp-for="RouteType" value="wildcard" id="route-type-wildcard" />
                            <span class="mat-choice__text"><strong>Wildcard</strong><small>One certificate for every subdomain of a domain</small></span>
                        </label>
                    </div>
                </fieldset>

                <div class="mat-form__grid">
                    <mat-field label="Host" asp-for="Host" required>
                        <input asp-for="Host" id="host-input" class="mat-input" autocapitalize="none" autocomplete="off" spellcheck="false" autofocus required data-msg-required="Please enter a host." />
                        <span class="mat-hint" id="host-hint"></span>
                    </mat-field>
                    <mat-field label="Name" asp-for="Name" hint="Optional. The host is used when it is empty.">
                        <input asp-for="Name" class="mat-input" />
                    </mat-field>
                </div>

                <div class="mat-alert mat-alert--warning" id="wildcard-nudge" hidden>
                    @Ui.Icon("alert")
                    <div class="mat-alert__body">
                        <span id="wildcard-nudge-text"></span>
                        <div class="mat-alert__actions">
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="wildcard-nudge-btn">@Ui.Icon("network")<span>Use a wildcard instead</span></button>
                        </div>
                    </div>
                </div>

                <div class="mat-form__grid" data-show-if="#route-type-wildcard" data-show-value="wildcard">
                    <mat-field label="DNS provider" asp-for="ProviderId" hint="Needed for the wildcard certificate.">
                        <select asp-for="ProviderId" class="mat-select">
                            @foreach (var (value, text) in Model.ProviderOptions)
                            {
                                <option value="@value" selected="@((Model.ProviderId?.ToString() ?? "") == value)">@text</option>
                            }
                        </select>
                    </mat-field>
                    <mat-field label="ACME e-mail address" asp-for="AcmeEmail" hint="Optional. Replaces the one under Settings.">
                        <input asp-for="AcmeEmail" type="email" class="mat-input" autocapitalize="none" autocomplete="off" />
                    </mat-field>
                </div>

                <label class="mat-switch"><input type="checkbox" asp-for="Enabled" /><span class="mat-switch__track"></span><span>Route active</span></label>
            </div>
        </section>

        <section class="mat-card" aria-labelledby="route-target-title">
            <div class="mat-card__head">@Ui.Icon("external")<h2 class="mat-card__title" id="route-target-title">Target</h2></div>
            <div class="mat-card__body mat-stack">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-legend">What happens to a request</legend>
                    <div class="mat-choices">
                        <label class="mat-choice">
                            <input type="radio" asp-for="Target" value="proxy" id="target-proxy" />
                            <span class="mat-choice__text"><strong>Reverse proxy</strong><small>Forward it to a service</small></span>
                        </label>
                        <label class="mat-choice">
                            <input type="radio" asp-for="Target" value="redirect" id="target-redirect" />
                            <span class="mat-choice__text"><strong>Redirect</strong><small>Send the visitor to another address</small></span>
                        </label>
                    </div>
                </fieldset>

                <div class="mat-stack" data-show-if="#target-proxy" data-show-value="proxy">
                    <mat-field label="Upstream" asp-for="Upstream" hint="For example http://backend:8080 or whoami:80." required>
                        <input asp-for="Upstream" class="mat-input mat-mono" autocapitalize="none" autocomplete="off" spellcheck="false" required data-msg-required="Please enter the service to forward to." />
                    </mat-field>
                    <div class="mat-field">
                        <label class="mat-switch"><input type="checkbox" asp-for="InsecureSkipVerify" /><span class="mat-switch__track"></span><span>Skip TLS verification (insecure)</span></label>
                        <span class="mat-hint">For an <code>https://</code> upstream with a self-signed certificate.</span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-switch"><input type="checkbox" asp-for="Compress" /><span class="mat-switch__track"></span><span>Compress responses</span></label>
                        <span class="mat-hint">zstd or gzip, for browsers that take it.</span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-switch"><input type="checkbox" asp-for="AllowEmbedding" /><span class="mat-switch__track"></span><span>Allow embedding in a frame</span></label>
                        <span class="mat-hint">Removes <code>X-Frame-Options</code> and CSP <code>frame-ancestors</code>, so another page (Mattiverse, MatOS) can show this site.</span>
                    </div>
                </div>

                <div class="mat-stack" data-show-if="#target-redirect" data-show-value="redirect">
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" for="redirect-preset">Redirect to</label>
                            <select id="redirect-preset" class="mat-select">
                                <option value="">Pick an existing domain</option>
                                @foreach (var t in Model.RedirectTargets)
                                {
                                    <option value="@t">@t</option>
                                }
                                <option value="__other__">Another address</option>
                            </select>
                        </div>
                        <mat-field label="Status code" asp-for="RedirectCode" hint="307 and 308 keep the method: a POST stays a POST.">
                            <select asp-for="RedirectCode" class="mat-select">
                                <option value="302">302 - temporary</option>
                                <option value="301">301 - permanent</option>
                                <option value="307">307 - temporary, keeps the method</option>
                                <option value="308">308 - permanent, keeps the method</option>
                            </select>
                        </mat-field>
                        <div class="mat-field">
                            <label class="mat-switch"><input type="checkbox" asp-for="RedirectKeepPath" /><span class="mat-switch__track"></span><span>Keep the path</span></label>
                            <span class="mat-hint">/docs?page=2 goes to the same path of the target.</span>
                        </div>
                    </div>
                    <div id="redirect-url-group" hidden>
                        <mat-field label="Target address" asp-for="FallbackUrl">
                            <input asp-for="FallbackUrl" type="url" class="mat-input" placeholder="https://target.example.com" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                    </div>
                </div>
            </div>
        </section>

        <section class="mat-card" aria-labelledby="route-access-title">
            <div class="mat-card__head">@Ui.Icon("lock")<h2 class="mat-card__title" id="route-access-title">Access</h2></div>
            <div class="mat-card__body mat-stack">
                <mat-field label="Authentication" asp-for="AuthenticationId">
                    <select asp-for="AuthenticationId" class="mat-select">
                        @foreach (var (value, text) in Model.AuthOptions)
                        {
                            <option value="@value" selected="@((Model.AuthenticationId?.ToString() ?? "") == value)">@text</option>
                        }
                    </select>
                </mat-field>
                <div class="mat-field">
                    <label class="mat-switch"><input type="checkbox" asp-for="BlockExploits" /><span class="mat-switch__track"></span><span>Block common exploits</span></label>
                    <span class="mat-hint">403 for SQL injection or script in the query and for paths like <code>/.git</code> or <code>/.env</code>.</span>
                </div>
                <div class="mat-field">
                    <label class="mat-switch"><input type="checkbox" asp-for="Hsts" /><span class="mat-switch__track"></span><span>HSTS</span></label>
                    <span class="mat-hint">Browsers use only HTTPS for this host, for a year.</span>
                </div>
            </div>
        </section>

        <section class="mat-card" aria-labelledby="route-response-title">
            <div class="mat-card__head">@Ui.Icon("code")<h2 class="mat-card__title" id="route-response-title">Response headers</h2></div>
            <div class="mat-card__body mat-stack">
                <details class="mat-collapse" open="@(Model.ResponseRows.Count > 0)" id="route-response">
                    <summary><span>Set or remove headers of the answer</span>@Ui.Icon("chevron-down", "mat-accordion__chev")</summary>
                    <div class="mat-accordion__body mat-stack">
                        <div class="mat-table-wrap">
                            <table class="mat-table" id="response-headers">
                                <caption class="mat-sr-only">Headers of the answer to the visitor</caption>
                                <thead><tr><th scope="col">Action</th><th scope="col">Name</th><th scope="col">Value</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr></thead>
                                <tbody>
                                    @foreach (var row in Model.ResponseRows)
                                    {
                                        <tr>
                                            <td data-label="Action">
                                                <select name="ResponseActions" class="mat-select" aria-label="Action">
                                                    <option value="set" selected="@(!row.Remove)">Set</option>
                                                    <option value="remove" selected="@row.Remove">Remove</option>
                                                </select>
                                            </td>
                                            <td data-label="Name"><input name="ResponseNames" value="@row.Name" class="mat-input mat-mono" aria-label="Header name" autocapitalize="none" autocomplete="off" spellcheck="false" /></td>
                                            <td data-label="Value"><input name="ResponseValues" value="@row.Value" class="mat-input mat-mono" aria-label="Header value" autocapitalize="none" autocomplete="off" spellcheck="false" /></td>
                                            <td class="mat-table__cell-actions"><div class="mat-table__actions"><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-remove-row aria-label="Remove the row @row.Name" data-tip="Remove">@Ui.Icon("trash")</button></div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <span class="mat-hint">For every answer of the host, also over what the upstream sends. Visible ASCII, no { or }; a removed header needs no value.</span>
                        <div class="mat-actions">
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-add-row="#response-headers tbody" data-template="response-row-template">@Ui.Icon("plus")<span>Add a header</span></button>
                        </div>
                        <template id="response-row-template">
                            <tr>
                                <td data-label="Action">
                                    <select name="ResponseActions" class="mat-select" aria-label="Action">
                                        <option value="set">Set</option>
                                        <option value="remove">Remove</option>
                                    </select>
                                </td>
                                <td data-label="Name"><input name="ResponseNames" class="mat-input mat-mono" aria-label="Header name" autocapitalize="none" autocomplete="off" spellcheck="false" placeholder="X-Content-Type-Options" /></td>
                                <td data-label="Value"><input name="ResponseValues" class="mat-input mat-mono" aria-label="Header value" autocapitalize="none" autocomplete="off" spellcheck="false" placeholder="nosniff" /></td>
                                <td class="mat-table__cell-actions"><div class="mat-table__actions"><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-remove-row aria-label="Remove the row" data-tip="Remove">@Ui.Icon("trash")</button></div></td>
                            </tr>
                        </template>
                    </div>
                </details>
            </div>
        </section>

        <section class="mat-card" aria-labelledby="route-guard-title">
            <div class="mat-card__head">@Ui.Icon("shield")<h2 class="mat-card__title" id="route-guard-title">Guards and upstream</h2></div>
            <div class="mat-card__body mat-stack">
                <details class="mat-collapse" open="@Model.AccessOpen" id="route-access">
                    <summary><span>IP lists, required header, headers to the upstream</span>@Ui.Icon("chevron-down", "mat-accordion__chev")</summary>
                    <div class="mat-accordion__body mat-stack">
                        <div class="mat-form__grid">
                            <mat-field label="Allowed IP addresses" asp-for="AllowedIpsText" hint="One address or range per line; every other one gets 403.">
                                <textarea asp-for="AllowedIpsText" rows="3" class="mat-textarea mat-mono" spellcheck="false" autocapitalize="none" autocomplete="off" placeholder="203.0.113.7&#10;10.0.0.0/8"></textarea>
                            </mat-field>
                            <mat-field label="Blocked IP addresses" asp-for="BlockedIpsText" hint="One address or range per line; these get 403.">
                                <textarea asp-for="BlockedIpsText" rows="3" class="mat-textarea mat-mono" spellcheck="false" autocapitalize="none" autocomplete="off" placeholder="198.51.100.0/24"></textarea>
                            </mat-field>
                        </div>
                        <p class="mat-hint">Both lists see the connection Caddy gets, not X-Forwarded-For: behind Docker Desktop or a NAT that can be the gateway.</p>

                        <div class="mat-form__grid">
                            <mat-field label="Required header" asp-for="RequireName" hint="Without exactly this header and value: 403. It is removed before the request goes upstream. Clear the name to drop it.">
                                <input asp-for="RequireName" class="mat-input mat-mono" autocapitalize="none" autocomplete="off" spellcheck="false" placeholder="X-Edge-Secret" />
                            </mat-field>
                            <mat-field label="Header value" for-id="RequireValue" hint="16+ visible ASCII characters, no * { }. Never shown again; empty keeps it.">
                                <input type="password" id="RequireValue" name="RequireValue" class="mat-input mat-mono" autocomplete="new-password" placeholder="@(Model.RequireSet ? "Set - leave empty to keep" : "")" />
                            </mat-field>
                        </div>

                        <div class="mat-stack" data-show-if="#target-proxy" data-show-value="proxy">
                            <mat-field label="Host header to the upstream" asp-for="UpstreamHost" hint="Sent instead of the visitor's host; for an https:// upstream also the TLS server name.">
                                <input asp-for="UpstreamHost" class="mat-input mat-mono" autocapitalize="none" autocomplete="off" spellcheck="false" placeholder="app.example.com" />
                            </mat-field>

                            <div class="mat-field">
                                <span class="mat-label">Headers to the upstream</span>
                                <div class="mat-table-wrap">
                                    <table class="mat-table" id="upstream-headers">
                                        <caption class="mat-sr-only">Headers sent to the upstream</caption>
                                        <thead><tr><th scope="col">Name</th><th scope="col">Value</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr></thead>
                                        <tbody>
                                            @foreach (var row in Model.HeaderRows)
                                            {
                                                <tr>
                                                    <td data-label="Name"><input name="HeaderNames" value="@row.Name" class="mat-input mat-mono" aria-label="Header name" autocapitalize="none" autocomplete="off" spellcheck="false" /></td>
                                                    <td data-label="Value"><input name="HeaderValues" type="password" class="mat-input mat-mono" placeholder="@(row.ValueSet ? "Set - leave empty to keep" : "")" aria-label="Header value" autocomplete="new-password" /></td>
                                                    <td class="mat-table__cell-actions"><div class="mat-table__actions"><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-remove-row aria-label="Remove the header @row.Name" data-tip="Remove">@Ui.Icon("trash")</button></div></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <span class="mat-hint">They replace a header of the same name from the visitor. Values are never shown again; empty keeps the saved one.</span>
                            </div>
                            <div class="mat-actions">
                                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-add-row="#upstream-headers tbody" data-template="header-row-template">@Ui.Icon("plus")<span>Add a header</span></button>
                            </div>
                            <template id="header-row-template">
                                <tr>
                                    <td data-label="Name"><input name="HeaderNames" class="mat-input mat-mono" aria-label="Header name" autocapitalize="none" autocomplete="off" spellcheck="false" placeholder="X-Edge-Secret" /></td>
                                    <td data-label="Value"><input name="HeaderValues" type="password" class="mat-input mat-mono" aria-label="Header value" autocomplete="new-password" /></td>
                                    <td class="mat-table__cell-actions"><div class="mat-table__actions"><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-remove-row aria-label="Remove the header" data-tip="Remove">@Ui.Icon("trash")</button></div></td>
                                </tr>
                            </template>
                        </div>
                    </div>
                </details>
            </div>
        </section>

        <mat-form-buttons>
            <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>Save</span></button>
            <a class="mat-btn mat-btn--secondary" asp-page="Index">@Ui.Icon("back")<span>Back</span></a>
            @if (!Model.IsNew)
            {
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete the route @Model.Host? This cannot be undone." data-confirm-ok="Delete">
                    @Ui.Icon("trash")<span>Delete</span>
                </button>
            }
        </mat-form-buttons>
    </form>
}

@section Scripts {
    <script src="~/js/route-edit.js" asp-append-version="true"></script>
}
