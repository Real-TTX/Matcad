@page
@model Matcad.Pages.Routes.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Create route" : "Edit route";
}
<div class="card">
    <div class="card__body">
        @if (Model.Error != null)
        {
            <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
        }

        @if (Model.PortBinding is { } port)
        {
            <div class="alert alert--info">
                <icon name="info" />
                <span>This is a port binding (<code>:@port</code>). It is managed through the API; the proxy listens on that port and forwards to <code>@Model.Upstream</code>. It can only be deleted here.</span>
            </div>
            <form method="post" class="mat-form">
                <input type="hidden" asp-for="Id" />
                <mat-form-buttons>
                    <a class="mat-btn mat-btn--ghost" asp-page="Index"><icon name="back" /><span>Back</span></a>
                    <span class="mat-buttons__spacer"></span>
                    <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete this port binding?">
                        <icon name="trash" /><span>Delete</span>
                    </button>
                </mat-form-buttons>
            </form>
        }
        else
        {
            <form method="post" class="mat-form">
                <input type="hidden" asp-for="Id" />

                <mat-field label="Type">
                    <div class="segmented">
                        <label class="seg-option">
                            <input type="radio" asp-for="RouteType" value="single" id="route-type-single" />
                            <span><icon name="route" /> Single domain</span>
                        </label>
                        <label class="seg-option">
                            <input type="radio" asp-for="RouteType" value="wildcard" id="route-type-wildcard" />
                            <span><icon name="network" /> Wildcard</span>
                        </label>
                    </div>
                    <span class="mat-hint" id="type-hint"></span>
                </mat-field>

                <div class="form-grid">
                    <mat-field label="Host" asp-for="Host">
                        <input asp-for="Host" id="host-input" class="mat-input" autocapitalize="none" autocomplete="off" spellcheck="false" autofocus />
                        <span class="mat-hint" id="host-hint"></span>
                    </mat-field>
                    <mat-field label="Name" asp-for="Name">
                        <input asp-for="Name" class="mat-input" placeholder="optional - otherwise the host is used" />
                    </mat-field>
                </div>

                <div class="alert alert--warning" id="wildcard-nudge" hidden>
                    <icon name="alert" />
                    <span id="wildcard-nudge-text"></span>
                    <button type="button" class="mat-btn mat-btn--sm" id="wildcard-nudge-btn"><icon name="network" /><span>Use wildcard instead</span></button>
                </div>

                <mat-field label="Target">
                    <div class="segmented">
                        <label class="seg-option">
                            <input type="radio" asp-for="Target" value="proxy" id="target-proxy" />
                            <span><icon name="route" /> Reverse proxy</span>
                        </label>
                        <label class="seg-option">
                            <input type="radio" asp-for="Target" value="redirect" id="target-redirect" />
                            <span><icon name="external" /> Redirect</span>
                        </label>
                    </div>
                </mat-field>

                <div class="mat-form" data-show-if="#target-proxy" data-show-value="proxy">
                    <mat-field label="Upstream (reverse-proxy target)" asp-for="Upstream" hint="Requests are proxied to this backend.">
                        <input asp-for="Upstream" class="mat-input" placeholder="http://backend:8080 or whoami:80" autocapitalize="none" autocomplete="off" spellcheck="false" />
                    </mat-field>
                    <div>
                        <label class="mat-switch"><input type="checkbox" asp-for="InsecureSkipVerify" /><span>Skip TLS verification (insecure)</span></label>
                        <div class="mat-hint" style="margin-top:6px">For <code>https://</code> upstreams with a self-signed or invalid certificate. Ignored for plain <code>http://</code> backends.</div>
                    </div>
                    <div>
                        <label class="mat-switch"><input type="checkbox" asp-for="AllowEmbedding" /><span>Allow embedding in an iframe</span></label>
                        <div class="mat-hint" style="margin-top:6px">Removes <code>X-Frame-Options</code> and CSP <code>frame-ancestors</code> from responses so this site can be shown inside another page (for example Mattiverse or matOS). Off by default: only enable it for apps you want to embed.</div>
                    </div>
                </div>

                <div class="mat-form" data-show-if="#target-redirect" data-show-value="redirect">
                    <div class="form-grid">
                        <mat-field label="Redirect to" hint="Every request to this host is redirected here.">
                            <select id="redirect-preset" class="mat-select">
                                <option value="">- pick an existing domain -</option>
                                @foreach (var t in Model.RedirectTargets)
                                {
                                    <option value="@t">@t</option>
                                }
                                <option value="__other__">Other (custom URL)...</option>
                            </select>
                        </mat-field>
                        <div>
                            <label class="mat-switch"><input type="checkbox" asp-for="PermanentRedirect" /><span>Permanent (301)</span></label>
                            <div class="mat-hint" style="margin-top:6px">Leave off for a temporary redirect (302).</div>
                        </div>
                    </div>
                    <div id="redirect-url-group" hidden>
                        <mat-field label="Target URL" asp-for="FallbackUrl">
                            <input asp-for="FallbackUrl" type="url" class="mat-input" placeholder="https://target.example.com" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                    </div>
                </div>

                <div class="form-grid">
                    <mat-field label="Authentication" asp-for="AuthenticationId">
                        <select asp-for="AuthenticationId" class="mat-select">
                            @foreach (var (value, text) in Model.AuthOptions)
                            {
                                <option value="@value" selected="@((Model.AuthenticationId?.ToString() ?? "") == value)">@text</option>
                            }
                        </select>
                    </mat-field>
                    <div data-show-if="#route-type-wildcard" data-show-value="wildcard">
                        <mat-field label="DNS provider (required for the wildcard certificate)" asp-for="ProviderId"
                                   hint="A wildcard certificate (*.domain) covers all subdomains, so subdomain routes need no provider of their own.">
                            <select asp-for="ProviderId" class="mat-select">
                                @foreach (var (value, text) in Model.ProviderOptions)
                                {
                                    <option value="@value" selected="@((Model.ProviderId?.ToString() ?? "") == value)">@text</option>
                                }
                            </select>
                        </mat-field>
                    </div>
                </div>

                <div data-show-if="#route-type-wildcard" data-show-value="wildcard">
                    <mat-field label="ACME e-mail (optional, per domain)" asp-for="AcmeEmail"
                               hint="Contact e-mail for this domain's certificate. Overrides the global ACME e-mail under Settings.">
                        <input asp-for="AcmeEmail" type="email" class="mat-input" placeholder="empty = global e-mail from Settings" />
                    </mat-field>
                </div>

                <label class="mat-switch"><input type="checkbox" asp-for="Enabled" /><span>Route active</span></label>

                <mat-form-buttons>
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                    <a class="mat-btn mat-btn--ghost" asp-page="Index"><icon name="back" /><span>Back</span></a>
                    @if (!Model.IsNew)
                    {
                        <span class="mat-buttons__spacer"></span>
                        <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete this route?">
                            <icon name="trash" /><span>Delete</span>
                        </button>
                    }
                </mat-form-buttons>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const wildcardParents = @Html.Raw(Model.WildcardParentsJson);
            const $ = id => document.getElementById(id);
            const host = $('host-input');
            if (!host) return;

            const routeType = () => document.querySelector('input[name="RouteType"]:checked')?.value || 'single';
            const parentOf = h => { const i = h.indexOf('.'); return i > 0 ? h.slice(i + 1) : ''; };

            // Warn when a single host (subdomain or apex) is not covered by any wildcard route,
            // so it would get its own individual certificate.
            function checkWildcard() {
                const nudge = $('wildcard-nudge');
                const h = (host.value || '').trim().toLowerCase().replace(/\.+$/, '');
                const labels = h.split('.').filter(Boolean).length;
                const internal = h === 'localhost' || h.endsWith('.localhost') || /^[0-9.]+$/.test(h);
                // A subdomain (3+ labels) needs *.<immediate parent>; an apex (2 labels) is folded into its own *.<host> certificate.
                const base = labels >= 3 ? parentOf(h) : h;
                const covered = wildcardParents.some(p => p.toLowerCase() === base);
                if (routeType() === 'single' && labels >= 2 && !h.startsWith('*.') && !internal && !covered) {
                    $('wildcard-nudge-text').textContent =
                        'No wildcard covers "' + h + '": Caddy will request an individual certificate for it. ' +
                        'A *.' + base + ' wildcard route would cover it (and its subdomains) with a single certificate.';
                    nudge.dataset.parent = base;
                    // Converting replaces this host, so it is only offered for a subdomain.
                    $('wildcard-nudge-btn').hidden = labels < 3;
                    nudge.hidden = false;
                } else {
                    nudge.hidden = true;
                }
            }

            function applyRouteType() {
                const wildcard = routeType() === 'wildcard';
                if (wildcard) {
                    // Make the wildcard explicit: the host starts with "*.".
                    const h = host.value.trim();
                    if (!h.startsWith('*.')) host.value = '*.' + h.replace(/^[*.]+/, '');
                    host.placeholder = '*.example.com';
                    $('host-hint').textContent = 'Wildcard: enter *.your-domain. Covers all direct subdomains (and the apex if you also add it). Needs a DNS provider (DNS-01).';
                    $('type-hint').textContent = 'One certificate for the whole domain; individual subdomains inherit it.';
                } else {
                    if (host.value.trim().startsWith('*.')) host.value = host.value.trim().slice(2);
                    host.placeholder = 'app.example.com';
                    $('host-hint').textContent = 'Exactly one host. Certificate via the HTTP challenge, or covered by a wildcard route.';
                    $('type-hint').textContent = 'A single concrete host.';
                }
                checkWildcard();
            }

            $('wildcard-nudge-btn').addEventListener('click', () => {
                const parent = $('wildcard-nudge').dataset.parent;
                if (!parent) return;
                $('route-type-wildcard').checked = true;
                host.value = '*.' + parent;
                $('route-type-wildcard').dispatchEvent(new Event('change', { bubbles: true }));
            });

            // Redirect target: a picker of existing domains fills the URL field; "Other" reveals it for free text.
            const url = $('FallbackUrl'), preset = $('redirect-preset'), urlGroup = $('redirect-url-group');
            function applyPreset() {
                const v = preset.value;
                if (v === '__other__') { urlGroup.hidden = false; url.focus(); }
                else { urlGroup.hidden = true; url.value = v; }
            }
            function initPreset() {
                const value = (url.value || '').trim();
                if (!value) { preset.value = ''; urlGroup.hidden = true; }
                else if (Array.from(preset.options).some(o => o.value === value)) { preset.value = value; urlGroup.hidden = true; }
                else { preset.value = '__other__'; urlGroup.hidden = false; }
            }

            document.querySelectorAll('input[name="RouteType"]').forEach(r => r.addEventListener('change', applyRouteType));
            host.addEventListener('input', checkWildcard);
            preset.addEventListener('change', applyPreset);
            applyRouteType();
            initPreset();

            // Prefilled as ".example.com" (Add subdomain): the cursor goes to the start, so the user types the label first.
            if (host.value.startsWith('.')) { host.focus(); host.setSelectionRange(0, 0); }
        })();
    </script>
}
