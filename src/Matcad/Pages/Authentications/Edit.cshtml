@page
@model Matcad.Pages.Authentications.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New authentication" : "Edit authentication";
    ViewData["PageSub"] = "Who may open the routes that use it, and for the Matcad login page how it looks.";
    ViewData["Crumbs"] = Crumbs.Of(("Authentications", "/Authentications"), (Model.IsNew ? "New authentication" : "Edit authentication", null));
    var logoMissing = string.IsNullOrWhiteSpace(Model.BrandLogo);
}

<form method="post" enctype="multipart/form-data" class="mat-form" novalidate>
    <input type="hidden" asp-for="Id" />

    @if (Model.Error != null)
    {
        <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@Model.Error</div></div>
    }

    <section class="mat-card" aria-labelledby="auth-title">
        <div class="mat-card__head">@Ui.Icon("lock")<h2 class="mat-card__title" id="auth-title">Authentication</h2></div>
        <div class="mat-card__body mat-stack">
            <div class="mat-form__grid">
                <mat-field label="Name" asp-for="Name" required>
                    <input asp-for="Name" class="mat-input" autofocus required data-msg-required="Please give the authentication a name." />
                </mat-field>
                <mat-field label="Type" asp-for="Type">
                    <select asp-for="Type" class="mat-select" id="auth-type">
                        <option value="BasicAuth">Basic Auth (the browser's own dialog)</option>
                        <option value="Matcad">Matcad (login page with a redirect back)</option>
                    </select>
                </mat-field>
            </div>
        </div>
    </section>

    <section class="mat-card" aria-labelledby="auth-users-title">
        <div class="mat-card__head">@Ui.Icon("users")<h2 class="mat-card__title" id="auth-users-title">Users</h2></div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">Both types keep their accounts here. Leave the password empty to keep an existing one.</p>
            <div class="mat-table-wrap">
                <table class="mat-table" id="basic-users">
                    <caption class="mat-sr-only">Users of this authentication</caption>
                    <thead><tr><th scope="col">Username</th><th scope="col">Password</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.ExistingUsers)
                        {
                            <tr>
                                <td data-label="Username"><input name="Usernames" value="@u.Username" class="mat-input" aria-label="Username" autocapitalize="none" autocomplete="off" spellcheck="false" /></td>
                                <td data-label="Password"><input name="Passwords" type="password" class="mat-input" placeholder="Unchanged" aria-label="Password" autocomplete="new-password" /></td>
                                <td class="mat-table__cell-actions"><div class="mat-table__actions"><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-remove-row aria-label="Remove the user @u.Username" data-tip="Remove">@Ui.Icon("trash")</button></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mat-actions">
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-add-row="#basic-users tbody" data-template="user-row-template">@Ui.Icon("plus")<span>Add a user</span></button>
            </div>
            <template id="user-row-template">
                <tr>
                    <td data-label="Username"><input name="Usernames" class="mat-input" aria-label="Username" autocapitalize="none" autocomplete="off" spellcheck="false" /></td>
                    <td data-label="Password"><input name="Passwords" type="password" class="mat-input" aria-label="Password" autocomplete="new-password" /></td>
                    <td class="mat-table__cell-actions"><div class="mat-table__actions"><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-remove-row aria-label="Remove the user" data-tip="Remove">@Ui.Icon("trash")</button></div></td>
                </tr>
            </template>
        </div>
    </section>

    <section class="mat-card" aria-labelledby="auth-login-title" data-show-if="#auth-type" data-show-value="Matcad">
        <div class="mat-card__head">@Ui.Icon("login")<h2 class="mat-card__title" id="auth-login-title">Login page</h2></div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">
                Visitors without a login see this page and, after signing in, go back to the page they asked for (Caddy <code>forward_auth</code>).
                Where the login is shown (on the site itself, as a redirect or as a plain 401) and the base domain are set under <a asp-page="/Settings/Index">Settings</a>.
            </p>
            <div class="mat-cols">
                <div class="mat-col-12 mat-col-lg-7">
                    <div class="mat-stack">
                        <mat-field label="Title" asp-for="BrandTitle" hint="Empty shows Matcad.">
                            <input asp-for="BrandTitle" class="mat-input" data-preview="title" />
                        </mat-field>
                        <mat-field label="Welcome text" asp-for="BrandText" hint="Empty shows “Protected area - please sign in”.">
                            <input asp-for="BrandText" class="mat-input" data-preview="text" />
                        </mat-field>
                        <mat-field label="Accent colour" asp-for="BrandColor" hint="The colour of the button and the focus. Empty keeps the colour of Matcad.">
                            <div class="mat-picker" data-picker="colour" data-clearable data-placeholder="The colour of Matcad">
                                <input class="mat-picker__input" asp-for="BrandColor" data-preview="color" />
                            </div>
                        </mat-field>
                        <mat-field label="Logo address" asp-for="BrandLogo" hint="An address, or upload a file below (PNG, JPEG, GIF, WebP, SVG or ICO, up to 256 KB, kept inside the configuration).">
                            <input asp-for="BrandLogo" class="mat-input" data-preview="logo" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                        <mat-field label="Logo upload" asp-for="LogoFile">
                            <input asp-for="LogoFile" type="file" accept="image/*" class="mat-input" />
                        </mat-field>
                        <fieldset class="mat-field mat-fieldset">
                            <legend class="mat-legend">Logo position</legend>
                            <div class="mat-checks mat-checks--inline">
                                <label class="mat-check"><input type="radio" asp-for="BrandLogoLayout" value="left" id="logo-layout-left" /><span class="mat-check__text">Beside the title</span></label>
                                <label class="mat-check"><input type="radio" asp-for="BrandLogoLayout" value="top" id="logo-layout-top" /><span class="mat-check__text">Above the title</span></label>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <div class="mat-col-12 mat-col-lg-5">
                    <div class="mat-field">
                        <span class="mat-label" id="preview-label">Preview</span>
                        <div class="mc-preview" data-app="matcad" id="preview-scope" role="group" aria-labelledby="preview-label">
                            <div class="mat-auth__card">
                                <div class="mat-auth__brand">
                                    <div class="mc-brand @(Model.BrandLogoLayout == "top" ? "mc-brand--top" : "")" id="preview-brand">
                                        <img class="mc-brand__img" id="preview-logo" alt="" src="@Model.BrandLogo" hidden="@logoMissing" />
                                        <span id="preview-logo-fallback" hidden="@(!logoMissing)">@Ui.Logo("lg")</span>
                                        <h3 id="preview-title">@(string.IsNullOrWhiteSpace(Model.BrandTitle) ? "Matcad" : Model.BrandTitle)</h3>
                                    </div>
                                    <p class="mat-muted" id="preview-text">@(string.IsNullOrWhiteSpace(Model.BrandText) ? "Protected area - please sign in" : Model.BrandText)</p>
                                </div>
                                <div class="mat-form" aria-hidden="true">
                                    <div class="mat-field"><span class="mat-label">Username</span><input type="text" class="mat-input" tabindex="-1" readonly /></div>
                                    <div class="mat-field"><span class="mat-label">Password</span><input type="password" class="mat-input" tabindex="-1" readonly /></div>
                                    <span class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("login")<span>Sign in</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <mat-form-buttons>
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>Save</span></button>
        <a class="mat-btn mat-btn--secondary" asp-page="Index">@Ui.Icon("back")<span>Back</span></a>
        @if (!Model.IsNew)
        {
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" formnovalidate data-confirm="Delete the authentication @Model.Name? This cannot be undone." data-confirm-ok="Delete">
                @Ui.Icon("trash")<span>Delete</span>
            </button>
        }
    </mat-form-buttons>
</form>

@section Scripts {
    <script src="~/js/authentication-edit.js" asp-append-version="true"></script>
}
