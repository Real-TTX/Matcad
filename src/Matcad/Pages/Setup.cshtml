@page
@model Matcad.Pages.SetupModel
@{
    Layout = "_PlainLayout";
    ViewData["Title"] = "Setup";
    var steps = new[] { ("account", "Account"), ("domains", "Domains and login"), ("provider", "DNS provider"), ("done", "Finish") };
    var current = Math.Max(0, Array.FindIndex(steps, s => s.Item1 == Model.Step));
}

<div class="mat-auth__card mc-wide">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>Welcome to Matcad</h1>
        <p class="mat-muted">A few quick steps to get going.</p>
    </div>

    <div class="mat-stack mat-stack--sm">
        <ol class="mat-steps" aria-label="Setup progress">
            @for (var i = 0; i < steps.Length; i++)
            {
                <li class="@(i == current ? "is-active" : i < current ? "is-done" : "")" aria-current="@(i == current ? "step" : null)"><span class="mat-sr-only">Step @(i + 1), @steps[i].Item2@(i < current ? ", done" : i == current ? ", current" : "")</span></li>
            }
        </ol>
        <p class="mat-muted mat-text-center">Step @(current + 1) of @steps.Length: @steps[current].Item2</p>
    </div>

    @if (Model.Error != null)
    {
        <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("x-circle")<div class="mat-alert__body">@Model.Error</div></div>
    }
    @if (Model.TestResult is { } test)
    {
        var tone = test.Ok == true ? "success" : test.Ok == false ? "danger" : "info";
        <div class="mat-alert mat-alert--@tone" role="status">@Ui.Icon(test.Ok == true ? "check-circle" : test.Ok == false ? "x-circle" : "info")<div class="mat-alert__body">@test.Message</div></div>
    }

    @if (Model.Step == "account")
    {
        <div class="mat-stack mat-stack--sm">
            <h2>@(Model.MustChange ? "Secure your account" : "Your account")</h2>
            @if (Model.MustChange)
            {
                <p class="mat-muted">Matcad starts with the login <code>admin</code> / <code>admin</code>. Choose your own before you go on.</p>
            }
        </div>
        <form method="post" asp-page-handler="Account" class="mat-form" novalidate>
            <div class="mat-form__grid">
                <mat-field label="Username" asp-for="NewUsername" required>
                    <input asp-for="NewUsername" class="mat-input" autocomplete="username" autocapitalize="none" spellcheck="false" required data-msg-required="Please enter a username." />
                </mat-field>
                <mat-field label="E-mail address" asp-for="NewEmail" hint="Optional. You can sign in with it, too.">
                    <input asp-for="NewEmail" type="email" class="mat-input" autocomplete="email" autocapitalize="none" data-msg-type="Please enter an address like name@example.com." />
                </mat-field>
                <mat-field label="New password" asp-for="NewPassword" hint="At least 8 characters." required="@Model.MustChange">
                    <input asp-for="NewPassword" type="password" class="mat-input" autocomplete="new-password" autofocus />
                </mat-field>
                <mat-field label="New password again" asp-for="ConfirmPassword" required="@Model.MustChange">
                    <input asp-for="ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
            </div>
            <mat-form-buttons class="mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary"><span>Continue</span>@Ui.Icon("chevron-right")</button>
            </mat-form-buttons>
        </form>
    }
    else if (Model.Step == "domains")
    {
        <h2>Domains and login</h2>
        <form method="post" asp-page-handler="Domains" class="mat-form" novalidate>
            <div class="mat-form__grid">
                <mat-field label="Base domain" asp-for="BaseDomain" hint="The parent domain of your sites. It lets one Matcad sign-in count on its subdomains.">
                    <input asp-for="BaseDomain" class="mat-input" placeholder="example.com" autocapitalize="none" spellcheck="false" autofocus />
                </mat-field>
                <mat-field label="Matcad host" asp-for="MatcadHost" hint="Optional. Shows this interface through Caddy under that host name.">
                    <input asp-for="MatcadHost" class="mat-input" placeholder="matcad.example.com" autocapitalize="none" spellcheck="false" />
                </mat-field>
                <mat-field label="Login behaviour" asp-for="PortalMode">
                    <select asp-for="PortalMode" class="mat-select">
                        <option value="inline">Inline: the login is shown on the protected site</option>
                        <option value="redirect">Redirect: send visitors to the Matcad host</option>
                        <option value="unauthorized">Unauthorized: a plain 401, no form</option>
                    </select>
                </mat-field>
                <mat-field label="ACME e-mail address" asp-for="AcmeEmail" hint="Optional. Only for Let's Encrypt expiry notices; certificates work without it.">
                    <input asp-for="AcmeEmail" type="email" class="mat-input" autocapitalize="none" />
                </mat-field>
            </div>
            <label class="mat-switch"><input type="checkbox" asp-for="SystemRouteEnabled" /><span class="mat-switch__track"></span><span>Show this interface under the Matcad host (system route)</span></label>
            <mat-form-buttons class="mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary"><span>Continue</span>@Ui.Icon("chevron-right")</button>
                <a class="mat-btn mat-btn--secondary" asp-page="Setup" asp-route-step="account">@Ui.Icon("back")<span>Back</span></a>
            </mat-form-buttons>
        </form>
    }
    else if (Model.Step == "provider")
    {
        <div class="mat-stack mat-stack--sm">
            <h2>DNS provider <span class="mat-muted">(optional)</span></h2>
            <p class="mat-muted">
                You only need one for <strong>wildcard certificates</strong> (<code>*.domain</code>) with the DNS-01 challenge. Single host names use HTTP validation and need none.
                You can skip this and add one later.
            </p>
        </div>
        <form method="post" class="mat-form" novalidate>
            <mat-field label="Name" asp-for="ProviderName">
                <input asp-for="ProviderName" class="mat-input" />
            </mat-field>

            <partial name="Controls/_ProviderFields" model="Model.ProviderFields" />

            <div class="mat-form__grid">
                <mat-field label="DNS propagation delay (seconds)" asp-for="PropagationDelay" hint="Slow providers such as netcup need about 120.">
                    <input asp-for="PropagationDelay" type="number" min="0" inputmode="numeric" class="mat-input mat-mono" />
                </mat-field>
                <mat-field label="Propagation timeout (seconds)" asp-for="PropagationTimeout" hint="-1 skips the check (recommended for netcup).">
                    <input asp-for="PropagationTimeout" type="number" min="-1" inputmode="numeric" class="mat-input mat-mono" />
                </mat-field>
            </div>

            <mat-form-buttons class="mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary" asp-page-handler="ProviderSave">@Ui.Icon("save")<span>Save and continue</span></button>
                <button type="submit" class="mat-btn mat-btn--secondary" asp-page-handler="ProviderTest" formnovalidate>@Ui.Icon("check-circle")<span>Test credentials</span></button>
                <button type="submit" class="mat-btn mat-btn--ghost" asp-page-handler="SkipProvider" formnovalidate><span>Skip</span>@Ui.Icon("chevron-right")</button>
            </mat-form-buttons>
        </form>
    }
    else
    {
        <div class="mat-stack mat-stack--sm">
            <h2>You're set up</h2>
            <p class="mat-muted">Next, add the sites Caddy should serve: create routes by hand, or import an existing Caddyfile.</p>
        </div>
        <div class="mat-actions">
            <a class="mat-btn mat-btn--secondary" asp-page="/Routes/Edit">@Ui.Icon("plus")<span>Add a route</span></a>
            <a class="mat-btn mat-btn--secondary" asp-page="/Settings/Import">@Ui.Icon("upload")<span>Import a Caddyfile</span></a>
        </div>
        <form method="post" asp-page-handler="Finish" novalidate>
            <mat-form-buttons class="mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("check")<span>Finish the setup</span></button>
                <a class="mat-btn mat-btn--secondary" asp-page="Setup" asp-route-step="provider">@Ui.Icon("back")<span>Back</span></a>
            </mat-form-buttons>
        </form>
    }

    @if (Model.Step != "done" && !Model.MustChange)
    {
        <form method="post" asp-page-handler="Skip" novalidate>
            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--block" formnovalidate data-confirm="Skip the setup? You can run it again under Settings." data-confirm-ok="Skip">Skip the setup for now</button>
        </form>
    }
</div>
