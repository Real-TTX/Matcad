@page
@model Matcad.Pages.SetupModel
@{
    Layout = "_PlainLayout";
    ViewData["Title"] = "Setup";
    var steps = new[] { ("account", "Account"), ("domains", "Domains & login"), ("provider", "DNS provider"), ("done", "Finish") };
    var current = Math.Max(0, Array.FindIndex(steps, s => s.Item1 == Model.Step));
}

<div class="login login--wide">
    <div class="login__brand">
        <img src="~/img/logo.svg" alt="" />
        <span class="name">Welcome to Matcad</span>
        <span class="tagline">A few quick steps to get going</span>
    </div>

    <div class="wizard">
        <div class="wizard__steps" aria-hidden="true">
            @for (var i = 0; i < steps.Length; i++)
            {
                <span class="wizard__dot @(i == current ? "is-active" : i < current ? "is-done" : "")"></span>
            }
        </div>
        <div class="wizard__step-title">Step @(current + 1) of @steps.Length: @steps[current].Item2</div>

        <div class="card">
            <div class="card__body">
                @if (Model.Error != null)
                {
                    <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
                }
                @if (Model.TestResult is { } test)
                {
                    var kind = test.Ok == true ? "success" : (test.Ok == false ? "error" : "warning");
                    <div class="alert alert--@kind"><icon name="@(test.Ok == true ? "check-circle" : test.Ok == false ? "x-circle" : "info")" /><span>@test.Message</span></div>
                }

                @if (Model.Step == "account")
                {
                    <h2>@(Model.MustChange ? "Secure your account" : "Your account")</h2>
                    @if (Model.MustChange)
                    {
                        <p class="text-muted" style="margin-top:6px">Matcad starts with the default login <code>admin / admin</code>. Choose your own before you go on.</p>
                    }
                    <form method="post" asp-page-handler="Account" class="mat-form" style="margin-top:14px">
                        <div class="form-grid">
                            <mat-field label="Username" asp-for="NewUsername">
                                <input asp-for="NewUsername" class="mat-input" autocomplete="username" autocapitalize="none" spellcheck="false" />
                            </mat-field>
                            <mat-field label="E-mail address (optional)" asp-for="NewEmail" hint="Can be used to sign in, too.">
                                <input asp-for="NewEmail" type="email" class="mat-input" autocomplete="email" />
                            </mat-field>
                            <mat-field label="@(Model.MustChange ? "New password" : "New password (optional)")" asp-for="NewPassword" hint="At least 8 characters.">
                                <input asp-for="NewPassword" type="password" class="mat-input" autocomplete="new-password" autofocus />
                            </mat-field>
                            <mat-field label="Confirm password" asp-for="ConfirmPassword">
                                <input asp-for="ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
                            </mat-field>
                        </div>
                        <mat-form-buttons>
                            <button type="submit" class="mat-btn mat-btn--primary"><span>Continue</span><icon name="chevron-right" /></button>
                        </mat-form-buttons>
                    </form>
                }
                else if (Model.Step == "domains")
                {
                    <h2>Domains &amp; login</h2>
                    <form method="post" asp-page-handler="Domains" class="mat-form" style="margin-top:14px">
                        <div class="form-grid">
                            <mat-field label="Base domain" asp-for="BaseDomain" hint="Parent domain shared by your sites. Enables one Matcad sign-in across subdomains.">
                                <input asp-for="BaseDomain" class="mat-input" placeholder="example.com" autocapitalize="none" spellcheck="false" autofocus />
                            </mat-field>
                            <mat-field label="Matcad host (optional)" asp-for="MatcadHost" hint="Exposes this UI through Caddy under that domain.">
                                <input asp-for="MatcadHost" class="mat-input" placeholder="matcad.example.com" autocapitalize="none" spellcheck="false" />
                            </mat-field>
                            <mat-field label="Login behaviour" asp-for="PortalMode">
                                <select asp-for="PortalMode" class="mat-select">
                                    <option value="inline">Inline (login on the protected site)</option>
                                    <option value="redirect">Redirect (to the Matcad host)</option>
                                    <option value="unauthorized">Unauthorized (plain 401, no form)</option>
                                </select>
                            </mat-field>
                            <mat-field label="ACME e-mail (optional)" asp-for="AcmeEmail" hint="Only for Let's Encrypt expiry notices. Leave empty - certificates still work.">
                                <input asp-for="AcmeEmail" type="email" class="mat-input" placeholder="empty = anonymous (like plain Caddy)" />
                            </mat-field>
                        </div>
                        <label class="mat-switch"><input type="checkbox" asp-for="SystemRouteEnabled" /><span>Expose the Matcad UI via the Matcad host (system route)</span></label>
                        <mat-form-buttons>
                            <button type="submit" class="mat-btn mat-btn--primary"><span>Continue</span><icon name="chevron-right" /></button>
                            <a class="mat-btn mat-btn--ghost" asp-page="Setup" asp-route-step="account"><icon name="back" /><span>Back</span></a>
                        </mat-form-buttons>
                    </form>
                }
                else if (Model.Step == "provider")
                {
                    <h2>DNS provider <span class="text-muted" style="font-weight:400">(optional)</span></h2>
                    <div class="alert alert--info" style="margin-top:12px">
                        <icon name="info" />
                        <span>
                            Only needed for <strong>wildcard certificates</strong> (<code>*.domain</code>) via the DNS-01 challenge.
                            For single hostnames Caddy uses HTTP validation: no provider required. You can skip this and add one later.
                        </span>
                    </div>
                    <form method="post" class="mat-form">
                        <mat-field label="Name" asp-for="ProviderName">
                            <input asp-for="ProviderName" class="mat-input" placeholder="e.g. Netcup" />
                        </mat-field>

                        <partial name="Controls/_ProviderFields" model="Model.ProviderFields" />

                        <div class="form-grid">
                            <mat-field label="DNS propagation delay (s)" asp-for="PropagationDelay" hint="Slow providers (netcup): 120.">
                                <input asp-for="PropagationDelay" type="number" min="0" inputmode="numeric" class="mat-input" />
                            </mat-field>
                            <mat-field label="Propagation timeout (s)" asp-for="PropagationTimeout" hint="-1 = skip the check (recommended for netcup).">
                                <input asp-for="PropagationTimeout" type="number" min="-1" inputmode="numeric" class="mat-input" />
                            </mat-field>
                        </div>

                        <mat-form-buttons>
                            <button type="submit" class="mat-btn mat-btn--primary" asp-page-handler="ProviderSave"><icon name="save" /><span>Save &amp; continue</span></button>
                            <button type="submit" class="mat-btn" asp-page-handler="ProviderTest" formnovalidate><icon name="check-circle" /><span>Test credentials</span></button>
                            <button type="submit" class="mat-btn mat-btn--ghost" asp-page-handler="SkipProvider" formnovalidate><span>Skip</span><icon name="chevron-right" /></button>
                        </mat-form-buttons>
                    </form>
                }
                else // done
                {
                    <h2>You're set up</h2>
                    <p class="text-muted" style="margin-top:6px">Next, add the sites Caddy should serve: create routes by hand, or import an existing Caddyfile.</p>
                    <mat-form-buttons>
                        <a class="mat-btn" asp-page="/Routes/Edit"><icon name="plus" /><span>Add a route</span></a>
                        <a class="mat-btn" asp-page="/Settings/Import"><icon name="upload" /><span>Import a Caddyfile</span></a>
                    </mat-form-buttons>
                    <form method="post" asp-page-handler="Finish">
                        <mat-form-buttons>
                            <button type="submit" class="mat-btn mat-btn--primary"><icon name="check" /><span>Finish setup</span></button>
                            <a class="mat-btn mat-btn--ghost" asp-page="Setup" asp-route-step="provider"><icon name="back" /><span>Back</span></a>
                        </mat-form-buttons>
                    </form>
                }
            </div>
        </div>

        @if (Model.Step != "done" && !Model.MustChange)
        {
            <form method="post" asp-page-handler="Skip" style="margin-top:14px;text-align:center">
                <button type="submit" class="mat-btn mat-btn--quiet mat-btn--sm" formnovalidate data-confirm="Skip the setup? You can run it again under Settings." data-confirm-ok="Skip">
                    Skip setup for now
                </button>
            </form>
        }
    </div>
</div>
