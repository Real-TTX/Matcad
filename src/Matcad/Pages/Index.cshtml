@page
@model Matcad.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageSub"] = "Traffic, routes and the requests as they arrive.";
}

@if (Model.FailedPush is { } push)
{
    <div class="mat-alert mat-alert--danger" role="alert">
        @Ui.Icon("x-circle")
        <div class="mat-alert__body">
            <strong>Caddy did not take the configuration.</strong> @push.Error
            @if (User.IsInRole("Admin"))
            {
                <div class="mat-alert__actions"><a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Settings">@Ui.Icon("settings")<span>Open the settings</span></a></div>
            }
        </div>
    </div>
}

<div class="mat-cols">
    <div class="mat-card mat-col-6 mat-col-lg-3"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Requests (24 h)</span><span class="mat-stat__value">@Model.Requests24h.ToString("N0")</span><span class="mat-stat__delta">@Model.TotalRequests.ToString("N0") in the log</span></div></div>
    <div class="mat-card mat-col-6 mat-col-lg-3"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Active routes</span><span class="mat-stat__value">@Model.ActiveRoutes.ToString("N0")</span><span class="mat-stat__delta">@(Model.InactiveRoutes == 0 ? "none switched off" : $"{Model.InactiveRoutes:N0} switched off")</span></div></div>
    <div class="mat-card mat-col-6 mat-col-lg-3"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Client errors (4xx)</span><span class="mat-stat__value">@Model.ClientErrors24h.ToString("N0")</span><span class="mat-stat__delta">in the last 24 h</span></div></div>
    <div class="mat-card mat-col-6 mat-col-lg-3"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Server errors (5xx)</span><span class="mat-stat__value">@Model.ServerErrors24h.ToString("N0")</span><span class="mat-stat__delta">in the last 24 h</span></div></div>
</div>

<section class="mat-card" aria-labelledby="routes-title">
    <div class="mat-card__head">@Ui.Icon("route")<h2 class="mat-card__title" id="routes-title">Routes</h2></div>
    <div class="mat-card__body">
        @if (Model.Groups.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon">@Ui.Icon("route")</span>
                <div class="mat-empty__title">No routes yet</div>
                <p>A route sends the requests for a host name to the service behind it.</p>
                <a class="mat-btn mat-btn--primary" asp-page="/Routes/Edit">@Ui.Icon("plus")<span>Add your first route</span></a>
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table" id="dashboard-routes" data-groups="dashboard-routes">
                    <caption class="mat-sr-only">Routes by domain</caption>
                    <thead>
                        <tr>
                            <th scope="col"><span class="mat-row mat-row--nowrap">Host <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-groups-set="toggle" data-groups-target="#dashboard-routes" aria-label="Open or close all domains" data-tip="Open or close all">@Ui.Icon("chevron-down")</button></span></th>
                            <th scope="col" class="mat-hide-sm">Target</th>
                            <th scope="col" class="mat-hide-sm">Last access</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    @foreach (var group in Model.Groups)
                    {
                        <tbody class="mat-group" data-group="@group.BaseDomain">
                            <tr class="mat-group__head">
                                <td class="mat-group__cell" colspan="5">
                                    <div class="mat-group__bar">
                                        <button type="button" class="mat-group__toggle" data-group-toggle aria-expanded="true">@Ui.Icon("chevron-down", "mat-group__chev")<span class="mat-group__title">@group.BaseDomain</span><span class="mat-badge mat-badge--soft">@group.Routes.Count<span class="mat-sr-only"> routes</span></span></button>
                                    </div>
                                </td>
                            </tr>
                            @foreach (var row in group.Routes)
                            {
                                var r = row.Route;
                                var cert = Model.Cert(r);
                                <tr class="mat-group__item @(r.Enabled ? "" : "mc-off")">
                                    <td data-label="Host"><partial name="_RouteName" model="new RouteNameModel(r, row.Label, group.BaseDomain, cert)" /></td>
                                    <td data-label="Target" class="mat-hide-sm mat-mono mat-text-break">
                                        @if (!string.IsNullOrEmpty(r.Upstream))
                                        {
                                            @r.Upstream
                                        }
                                        else if (!string.IsNullOrEmpty(r.FallbackUrl))
                                        {
                                            <text>↪ @r.FallbackUrl</text>
                                        }
                                        else
                                        {
                                            <text>-</text>
                                        }
                                    </td>
                                    <td data-label="Last access" class="mat-hide-sm">
                                        @if (row.LastAccess is DateTime lastAccess)
                                        {
                                            @Ui.LocalTime(lastAccess, "short")
                                        }
                                        else
                                        {
                                            <span class="mat-muted">no access yet</span>
                                        }
                                    </td>
                                    <td data-label="Status">
                                        @if (r.Enabled) { <span class="mat-pill mat-pill--ok">Active</span> }
                                        else { <span class="mat-pill">Inactive</span> }
                                    </td>
                                    <td class="mat-table__cell-actions">
                                        <div class="mat-table__actions">
                                            @if (!r.Wildcard && !string.IsNullOrWhiteSpace(r.Host))
                                            {
                                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm mat-hide-sm" href="https://@r.Host" target="_blank" rel="noopener" aria-label="Open @r.Host" data-tip="Open">@Ui.Icon("external")</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>
        }
    </div>
</section>

<section class="mat-card" aria-labelledby="log-title">
    <div class="mat-card__head">
        @Ui.Icon("clock")<h2 class="mat-card__title" id="log-title">Recent requests</h2>
        <span class="mat-pill mc-log__status" id="log-status">Connecting</span>
    </div>
    <div class="mat-card__body">
        <div class="mc-log" id="log-stream" role="log" aria-live="off" aria-label="Recent requests">
            <div class="mat-muted mc-log__empty">Waiting for requests...</div>
        </div>
    </div>
</section>
