@page "/auth/portal"
@model Matcad.Pages.Auth.PortalModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_PortalLayout";
    var b = Model.AuthConfig;
    var title = !string.IsNullOrWhiteSpace(b?.BrandTitle) ? b!.BrandTitle : Ui.App.Name;
    var text = !string.IsNullOrWhiteSpace(b?.BrandText) ? b!.BrandText : "Protected area - please sign in";
    // The accent is checked as #rgb or #rrggbb when it is saved; the layout re-colours the page with it.
    ViewData["BrandAccent"] = BrandAccent.Normalize(b?.BrandColor);
}
<div class="mat-auth__card">
    <div class="mat-auth__brand">
        <div class="mc-brand @(b?.BrandLogoLayout == "top" ? "mc-brand--top" : "")">
            @if (!string.IsNullOrWhiteSpace(b?.BrandLogo))
            {
                <img class="mc-brand__img" src="@b!.BrandLogo" alt="" />
            }
            else
            {
                @Ui.Logo("lg")
            }
            <h1>@title</h1>
        </div>
        <p class="mat-muted">@text</p>
    </div>

    <form method="post" class="mat-form" novalidate>
        <input type="hidden" asp-for="Auth" />
        <input type="hidden" asp-for="Rd" />
        @if (Model.Error != null)
        {
            <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<div class="mat-alert__body">@Model.Error</div></div>
        }
        <mat-field label="Username" asp-for="Username">
            <input asp-for="Username" class="mat-input" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required data-msg-required="Please enter your username." />
        </mat-field>
        <mat-field label="Password" asp-for="Password">
            <input asp-for="Password" type="password" class="mat-input" autocomplete="current-password" required data-msg-required="Please enter your password." />
        </mat-field>
        <div class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("login")<span>Sign in</span></button>
        </div>
    </form>
</div>
