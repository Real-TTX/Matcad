@page "/auth/portal"
@model Matcad.Pages.Auth.PortalModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_PortalLayout";
    var b = Model.AuthConfig;
    var title = !string.IsNullOrWhiteSpace(b?.BrandTitle) ? b!.BrandTitle : "Matcad";
    var text = !string.IsNullOrWhiteSpace(b?.BrandText) ? b!.BrandText : "Protected area - please sign in";
    // The colour is checked as #rgb / #rrggbb when it is saved; it re-colours the accent of the card.
    var color = !string.IsNullOrWhiteSpace(b?.BrandColor) ? b!.BrandColor : null;
    var brandClass = b?.BrandLogoLayout == "top" ? "login-brand brand-top" : "login-brand";
}
<div class="card" style="@(color == null ? null : $"--accent:{color};--accent-grad:{color}")">
    <h1 class="@brandClass">
        @if (!string.IsNullOrWhiteSpace(b?.BrandLogo))
        {
            <img src="@b!.BrandLogo" alt="" style="height:2rem;max-width:100%" />
        }
        else
        {
            <partial name="_Logo" />
        }
        <span>@title</span>
    </h1>
    <p class="text-muted">@text</p>
    @if (Model.Error != null)
    {
        <div class="alert">@Model.Error</div>
    }
    <form method="post">
        <input type="hidden" asp-for="Auth" />
        <input type="hidden" asp-for="Rd" />
        <div class="mat-field">
            <label class="mat-label" asp-for="Username">Username</label>
            <input asp-for="Username" class="mat-input" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
        </div>
        <div class="mat-field">
            <label class="mat-label" asp-for="Password">Password</label>
            <input asp-for="Password" type="password" class="mat-input" autocomplete="current-password" />
        </div>
        <button type="submit" class="mat-btn"><icon name="login" /><span>Sign in</span></button>
    </form>
</div>
