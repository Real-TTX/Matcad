@page
@model Matcad.Pages.StatisticsModel
@{
    ViewData["Title"] = "Statistics";
    var maxBar = Model.Series.Count > 0 ? Math.Max(1, Model.Series.Max(b => b.Count)) : 1;
    var statusClasses = new[] {
        ("2xx", Model.C2xx, "st-2"), ("3xx", Model.C3xx, "st-3"),
        ("4xx", Model.C4xx, "st-4"), ("5xx", Model.C5xx, "st-5") };
    var maxClass = Math.Max(1, statusClasses.Max(c => c.Item2));
}
<div class="mat-table">
    <div class="mat-table__toolbar">
        <form method="get" class="js-autosubmit">
            <div class="toolbar-field">
                <label for="stat-range">Time</label>
                <select id="stat-range" name="Range" class="mat-select">
                    <option value="1h" selected="@(Model.Range == "1h")">Last hour</option>
                    <option value="24h" selected="@(Model.Range == "24h")">Last 24 hours</option>
                    <option value="7d" selected="@(Model.Range == "7d")">Last 7 days</option>
                    <option value="30d" selected="@(Model.Range == "30d")">Last 30 days</option>
                    <option value="all" selected="@(Model.Range == "all")">All time</option>
                </select>
            </div>
            <div class="toolbar-field">
                <label for="stat-host">Host</label>
                <select id="stat-host" name="Host" class="mat-select">
                    <option value="">All hosts</option>
                    @foreach (var h in Model.HostOptions)
                    {
                        <option value="@h" selected="@(Model.Host == h)">@h</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="stat-status">Status</label>
                <select id="stat-status" name="Status" class="mat-select">
                    <option value="" selected="@(Model.Status == "")">Any</option>
                    <option value="2" selected="@(Model.Status == "2")">2xx</option>
                    <option value="3" selected="@(Model.Status == "3")">3xx</option>
                    <option value="4" selected="@(Model.Status == "4")">4xx</option>
                    <option value="5" selected="@(Model.Status == "5")">5xx</option>
                </select>
            </div>
            <div class="toolbar-field">
                <label for="stat-method">Method</label>
                <select id="stat-method" name="Method" class="mat-select">
                    <option value="">Any</option>
                    @foreach (var m in Matcad.Pages.StatisticsModel.MethodOptions)
                    {
                        <option value="@m" selected="@(Model.Method == m)">@m</option>
                    }
                </select>
            </div>
            <div class="search">
                <icon name="search" />
                <input type="search" name="Q" value="@Model.Q" class="mat-input" placeholder="Path contains..." aria-label="Path contains" enterkeyhint="search" />
            </div>
        </form>
    </div>
</div>

@if (Model.Total == 0)
{
    <div class="card"><div class="empty-state"><div><icon name="bar-chart" /></div>No requests match these filters.</div></div>
}
else
{
    <div class="widgets">
        <div class="widget"><div class="widget__icon"><icon name="activity" /></div><div><div class="widget__value">@Model.Total.ToString("N0")</div><div class="widget__label">Requests</div></div></div>
        <div class="widget"><div class="widget__icon widget__icon--warning"><icon name="alert" /></div><div><div class="widget__value">@Model.ErrorRate.ToString("0.0")%</div><div class="widget__label">Error rate (4xx/5xx)</div></div></div>
        <div class="widget"><div class="widget__icon"><icon name="clock" /></div><div><div class="widget__value">@Model.AvgDurationMs.ToString("0.0") ms</div><div class="widget__label">Avg. duration</div></div></div>
        <div class="widget"><div class="widget__icon"><icon name="globe" /></div><div><div class="widget__value">@Model.DistinctHosts.ToString("N0")</div><div class="widget__label">Hosts</div></div></div>
        <div class="widget"><div class="widget__icon"><icon name="users" /></div><div><div class="widget__value">@Model.DistinctClients.ToString("N0")</div><div class="widget__label">Client IPs</div></div></div>
    </div>

    <div class="card">
        <div class="card__header"><icon name="bar-chart" /><span>Requests over time <span class="text-muted" style="font-weight:400;font-size:.85rem">(per @Model.SeriesUnit)</span></span></div>
        <div class="card__body">
            <div class="bars" role="img" aria-label="Requests over time">
                @foreach (var b in Model.Series)
                {
                    var h = (int)Math.Round(b.Count * 100.0 / maxBar);
                    <div class="bar" title="@b.Label - @b.Count">
                        <div class="fill" style="height:@(b.Count == 0 ? 0 : Math.Max(2, h))%"></div>
                    </div>
                }
            </div>
            <div class="bars-axis">
                <span>@(Model.Series.FirstOrDefault()?.Label)</span>
                <span>@(Model.Series.LastOrDefault()?.Label)</span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card__header"><icon name="activity" /><span>Status codes</span></div>
        <div class="card__body">
            <div class="status-bars">
                @foreach (var (name, count, cls) in statusClasses)
                {
                    <div class="status-row">
                        <span class="status-name @cls">@name</span>
                        <div class="status-track"><div class="status-fill @cls" style="width:@((int)Math.Round(count * 100.0 / maxClass))%"></div></div>
                        <span class="status-count">@count.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card-grid">
        <div class="mat-table">
            <div class="mat-table__head"><icon name="globe" /><span>Top hosts</span></div>
            <div class="mat-table__scroll">
                <table class="data">
                    <thead><tr><th>Host</th><th class="actions">Requests</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.TopHosts)
                        {
                            <tr><td>@c.Key</td><td class="actions">@c.Value.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mat-table">
            <div class="mat-table__head"><icon name="link" /><span>Top paths</span></div>
            <div class="mat-table__scroll">
                <table class="data">
                    <thead><tr><th>Path</th><th class="actions">Requests</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.TopPaths)
                        {
                            <tr><td class="rtarget">@c.Key</td><td class="actions">@c.Value.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mat-table">
            <div class="mat-table__head"><icon name="users" /><span>Top clients</span></div>
            <div class="mat-table__scroll">
                <table class="data">
                    <thead><tr><th>Client IP</th><th class="actions">Requests</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.TopClients)
                        {
                            <tr><td class="rtarget">@(string.IsNullOrEmpty(c.Key) ? "(unknown)" : c.Key)</td><td class="actions">@c.Value.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mat-table">
        <div class="mat-table__head"><icon name="clock" /><span>Recent matching requests <span class="text-muted" style="font-weight:400;font-size:.85rem">(latest 100)</span></span></div>
        <div class="mat-table__scroll" style="margin-top:12px">
            <table class="data">
                <thead>
                    <tr>
                        <th>Time</th><th>Host</th><th class="hide-sm">Method</th><th>Path</th><th>Status</th>
                        <th class="hide-sm">Duration</th><th class="hide-sm">Client</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.RecentRows)
                    {
                        <tr>
                            <td class="text-muted nowrap">@Cell.LocalTime(r.At)</td>
                            <td>@r.Host</td>
                            <td class="hide-sm">@r.Method</td>
                            <td class="rtarget">@r.Path</td>
                            <td><span class="st-@(r.Status / 100)">@r.Status</span></td>
                            <td class="text-muted hide-sm">@r.DurationMs.ToString("0.0") ms</td>
                            <td class="text-muted hide-sm">@r.RemoteIp</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
