@page
@model Matcad.Pages.StatisticsModel
@{
    ViewData["Title"] = "Statistics";
    ViewData["PageSub"] = "The request log, filtered: traffic over time, status codes, and the busiest hosts, paths and clients.";
    ViewData["Crumbs"] = Crumbs.Of(("Statistics", null));
    var maxBar = Model.Series.Count > 0 ? Math.Max(1, Model.Series.Max(b => b.Count)) : 1;
    var statusClasses = new[]
    {
        ("2xx", Model.C2xx, "ok", "Successful"),
        ("3xx", Model.C3xx, "", "Redirected"),
        ("4xx", Model.C4xx, "warn", "Client error"),
        ("5xx", Model.C5xx, "error", "Server error"),
    };
    var maxClass = Math.Max(1, statusClasses.Max(c => c.Item2));
    string StatusTone(int status) => (status / 100) switch { 2 => "ok", 3 => "info", 4 => "warn", _ => "error" };
}

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
</div>

@if (Model.Total == 0)
{
    <div class="mat-empty">
        <span class="mat-empty__icon">@Ui.Icon("bar-chart")</span>
        <div class="mat-empty__title">No requests match</div>
        <p>Change the search or the filters, or reset them.</p>
        <a class="mat-btn mat-btn--primary" asp-page="Statistics">@Ui.Icon("refresh")<span>Reset the tools</span></a>
    </div>
}
else
{
    <div class="mat-cols">
        <div class="mat-card mat-col-6 mat-col-lg-3"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Requests</span><span class="mat-stat__value">@Model.Total.ToString("N0")</span><span class="mat-stat__delta">in the chosen time</span></div></div>
        <div class="mat-card mat-col-6 mat-col-lg-3"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Error rate</span><span class="mat-stat__value">@Model.ErrorRate.ToString("0.0")&nbsp;%</span><span class="mat-stat__delta">answered with 4xx or 5xx</span></div></div>
        <div class="mat-card mat-col-6 mat-col-lg-3"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Average duration</span><span class="mat-stat__value">@Model.AvgDurationMs.ToString("0.0")&nbsp;ms</span><span class="mat-stat__delta">per request</span></div></div>
        <div class="mat-card mat-col-6 mat-col-lg-3"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Clients</span><span class="mat-stat__value">@Model.DistinctClients.ToString("N0")</span><span class="mat-stat__delta">IP addresses on @Model.DistinctHosts.ToString("N0") @(Model.DistinctHosts == 1 ? "host" : "hosts")</span></div></div>
    </div>

    <section class="mat-card" aria-labelledby="series-title">
        <div class="mat-card__head">@Ui.Icon("bar-chart")<h2 class="mat-card__title" id="series-title">Requests over time</h2><span class="mat-card__sub">per @Model.SeriesUnit</span></div>
        <div class="mat-card__body">
            <div class="mc-bars" role="img" aria-label="Requests per @Model.SeriesUnit, from @Model.Series.FirstOrDefault()?.Label to @Model.Series.LastOrDefault()?.Label, at most @maxBar.ToString("N0")">
                @foreach (var b in Model.Series)
                {
                    var h = b.Count == 0 ? 0 : Math.Max(2, (int)Math.Round(b.Count * 100.0 / maxBar));
                    <div class="mc-bars__bar" title="@b.Label: @b.Count"><div class="mc-bars__fill" data-mc-value="@h"></div></div>
                }
            </div>
            <div class="mc-bars__axis" aria-hidden="true">
                <span>@(Model.Series.FirstOrDefault()?.Label)</span>
                <span>@(Model.Series.LastOrDefault()?.Label)</span>
            </div>
        </div>
    </section>

    <section class="mat-card" aria-labelledby="status-title">
        <div class="mat-card__head">@Ui.Icon("activity")<h2 class="mat-card__title" id="status-title">Status codes</h2></div>
        <div class="mat-card__body mat-stack mat-stack--sm">
            @foreach (var (name, count, tone, text) in statusClasses)
            {
                var share = (int)Math.Round(count * 100.0 / maxClass);
                <div class="mc-status">
                    <span class="mc-status__name">@name<span class="mat-sr-only"> @text</span></span>
                    <div class="mat-meter" role="progressbar" aria-valuenow="@count" aria-valuemin="0" aria-valuemax="@Model.Total" aria-label="@name: @count.ToString("N0") requests">
                        <div class="mat-meter__fill" data-value="@share" @(tone.Length == 0 ? null : Html.Raw($"data-tone=\"{tone}\""))></div>
                    </div>
                    <span class="mat-mono mc-status__count">@count.ToString("N0")</span>
                </div>
            }
        </div>
    </section>

    <div class="mat-grid mat-grid--3">
        <section class="mat-card" aria-labelledby="hosts-title">
            <div class="mat-card__head">@Ui.Icon("globe")<h2 class="mat-card__title" id="hosts-title">Top hosts</h2></div>
            <div class="mat-card__body">
                <div class="mat-table-wrap">
                    <table class="mat-table mat-table--compact">
                        <caption class="mat-sr-only">Top hosts</caption>
                        <thead><tr><th scope="col">Host</th><th scope="col" class="mat-num">Requests</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.TopHosts)
                            {
                                <tr><td data-label="Host" class="mat-text-break">@c.Key</td><td data-label="Requests" class="mat-num mat-mono">@c.Value.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        <section class="mat-card" aria-labelledby="paths-title">
            <div class="mat-card__head">@Ui.Icon("link")<h2 class="mat-card__title" id="paths-title">Top paths</h2></div>
            <div class="mat-card__body">
                <div class="mat-table-wrap">
                    <table class="mat-table mat-table--compact">
                        <caption class="mat-sr-only">Top paths</caption>
                        <thead><tr><th scope="col">Path</th><th scope="col" class="mat-num">Requests</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.TopPaths)
                            {
                                <tr><td data-label="Path" class="mat-mono mat-text-break">@c.Key</td><td data-label="Requests" class="mat-num mat-mono">@c.Value.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        <section class="mat-card" aria-labelledby="clients-title">
            <div class="mat-card__head">@Ui.Icon("users")<h2 class="mat-card__title" id="clients-title">Top clients</h2></div>
            <div class="mat-card__body">
                <div class="mat-table-wrap">
                    <table class="mat-table mat-table--compact">
                        <caption class="mat-sr-only">Top clients</caption>
                        <thead><tr><th scope="col">Client IP</th><th scope="col" class="mat-num">Requests</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.TopClients)
                            {
                                <tr><td data-label="Client IP" class="mat-mono mat-text-break">@(string.IsNullOrEmpty(c.Key) ? "(unknown)" : c.Key)</td><td data-label="Requests" class="mat-num mat-mono">@c.Value.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <section class="mat-card" aria-labelledby="recent-title">
        <div class="mat-card__head">@Ui.Icon("clock")<h2 class="mat-card__title" id="recent-title">Recent matching requests</h2><span class="mat-card__sub">the latest 100</span></div>
        <div class="mat-card__body">
            <div class="mat-table-wrap">
                <table class="mat-table mat-table--compact">
                    <caption class="mat-sr-only">Recent matching requests</caption>
                    <thead>
                        <tr>
                            <th scope="col">Time</th><th scope="col">Host</th><th scope="col" class="mat-hide-sm">Method</th><th scope="col">Path</th><th scope="col">Status</th>
                            <th scope="col" class="mat-hide-sm mat-num">Duration</th><th scope="col" class="mat-hide-sm">Client</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.RecentRows)
                        {
                            <tr>
                                <td data-label="Time" class="mat-mono">@Ui.LocalTime(r.At)</td>
                                <td data-label="Host" class="mat-text-break">@r.Host</td>
                                <td data-label="Method" class="mat-hide-sm mat-mono">@r.Method</td>
                                <td data-label="Path" class="mat-mono mat-text-break">@r.Path</td>
                                <td data-label="Status"><span class="mat-pill mat-pill--@StatusTone(r.Status)">@r.Status</span></td>
                                <td data-label="Duration" class="mat-hide-sm mat-num mat-mono">@r.DurationMs.ToString("0.0") ms</td>
                                <td data-label="Client" class="mat-hide-sm mat-mono">@r.RemoteIp</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
